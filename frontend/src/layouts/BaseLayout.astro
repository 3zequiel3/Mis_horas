---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/modales.css';
import '../styles/invitaciones-modal.css';

export interface Props {
  title?: string;
}

const { title = 'TimeFlow' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="description" content="TimeFlow — Sistema de gestión de tiempo, proyectos y asistencia" />
    <meta name="theme-color" content="#0f1419" />
    <title>{title} | TimeFlow</title>
  </head>
  <body>
    <slot />
    
    <!-- Alpine.js Global Initialization -->
    <script>
      import Alpine from 'alpinejs';
      
      if (typeof window !== 'undefined') {
        window.Alpine = Alpine;
        Alpine.start();
      }
    </script>
  </body>
</html>
