---
/**
 * Layout con soporte para branding dinámico
 * Inicializa CSS Variables basado en project brand_color
 */

interface Props {
  title: string;
  projectId?: number;
}

const { title, projectId } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    
    <!-- CSS Variables de branding dinámico (namespaced para evitar colisión con tokens.css) -->
    <style is:inline>
      :root {
        /* Branding por defecto — sobreescritas por loadProjectBranding() en runtime */
        --brand-primary: #3b82f6;
        --brand-primary-dark: #2563eb;
        --brand-primary-light: #60a5fa;
        --brand-accent: #8b5cf6;
        --brand-primary-rgb: 59, 130, 246;
      }
      
      .dark {
        /* En dark mode, hereda de tokens del sistema como base */
        --brand-background: var(--tf-bg-base, #111827);
        --brand-text: var(--tf-text-primary, #f9fafb);
        --brand-border: var(--tf-border, rgba(255, 255, 255, 0.1));
      }
    </style>
  </head>
  <body data-project-id={projectId}>
    <slot />
    
    <!-- Branding Loader -->
    {projectId && (
      <script>
        import { loadProjectBranding, restoreProjectBranding } from '../utils/brandingLoader';
        
        const projectId = parseInt(document.body.getAttribute('data-project-id') || '0', 10);
        
        if (projectId > 0) {
          // Intentar restaurar desde cache primero (más rápido)
          restoreProjectBranding(projectId);
          
          // Luego cargar desde API por si cambió
          loadProjectBranding(projectId).catch(err => {
            console.warn('Failed to load project branding:', err);
          });
        }
      </script>
    )}
  </body>
</html>
