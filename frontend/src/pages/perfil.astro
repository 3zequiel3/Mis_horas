---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProtectedRoute from '../components/ProtectedRoute.astro';

const pageTitle = 'Mi Perfil';
---

<script>
  import '../styles/perfil.css';
</script>

<BaseLayout title={pageTitle}>
  <ProtectedRoute>
    <Header />
    <main class="container" role="main" aria-label="Mi perfil">
    <div class="perfil-container">
      <div class="perfil-card">
        <div class="card-header">
          <h1>Mi Perfil</h1>
          <p>Administra tu información personal</p>
        </div>

        <div class="perfil-content">
          <!-- Información Básica -->
          <fieldset class="section">
            <legend><h2>Información Personal</h2></legend>
            <div class="form-group">
              <label for="username">Username</label>
              <input type="text" id="username" readonly aria-readonly="true" />
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" aria-required="true" />
            </div>

            <div class="form-group">
              <label for="nombre_completo">Nombre Completo</label>
              <input type="text" id="nombre_completo" />
            </div>

            <button id="save-profile-btn" class="btn btn-primary">
              💾 Guardar Cambios
            </button>
          </fieldset>

          <!-- Seguridad -->
          <fieldset class="section">
            <legend><h2>Seguridad</h2></legend>
            <div class="form-group">
              <label for="password_actual">Contraseña Actual</label>
              <input type="password" id="password_actual" aria-required="true" />
            </div>

            <div class="form-group">
              <label for="password_nueva">Nueva Contraseña</label>
              <input type="password" id="password_nueva" aria-required="true" />
            </div>

            <button id="change-password-btn" class="btn btn-primary">
              🔐 Cambiar Contraseña
            </button>
          </fieldset>

          <!-- Configuración de Horas -->
          <fieldset class="section">
            <legend><h2>Configuración</h2></legend>
            <div class="config-item">
              <label for="usar-horas-reales">
                <input type="checkbox" id="usar-horas-reales" />
                Usar Horas Reales
              </label>
              <p class="help-text">
                Si está activado, se usarán horas reales en lugar de horas estimadas
              </p>
            </div>

            <div class="config-item">
              <label>Día de Inicio de Semana</label>
              <select id="dia-inicio-semana" class="form-select">
                <option value="0">Domingo</option>
                <option value="1">Lunes</option>
              </select>
              <p class="help-text">
                Define qué día comienza la semana en la vista de proyectos
              </p>
            </div>

            <button id="toggle-horas-btn" class="btn btn-secondary">
              ⏱️ Actualizar Configuración
            </button>
          </fieldset>
        </div>

        <div id="success-message" class="alert alert-success" style="display: none;">
          ✓ Cambios guardados exitosamente
        </div>

        <div id="error-message" class="alert alert-error" style="display: none;">
          ✗ Error al guardar los cambios
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  fieldset legend {
    width: 100%;
  }

  fieldset legend h2 {
    margin: 0;
  }
</style>

<script>
  import { AuthService } from '../services/auth';
  import { PerfilHandler } from '../handlers/perfil';

  // Verificar autenticación
  if (!AuthService.isAuthenticated()) {
    window.location.href = '/login';
  }

  // Guardar perfil
  document.getElementById('save-profile-btn')?.addEventListener('click', async () => {
    await PerfilHandler.guardarPerfil();
  });

  // Cambiar contraseña
  document.getElementById('change-password-btn')?.addEventListener('click', async () => {
    await PerfilHandler.cambiarContraseña();
  });

  // Actualizar configuración
  document.getElementById('toggle-horas-btn')?.addEventListener('click', async () => {
    await PerfilHandler.actualizarConfiguracion();
  });

  // Cargar datos del usuario
  PerfilHandler.loadUserData();
</script>
