---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ProtectedRoute from '../../components/ProtectedRoute.astro';
import ConfigDrawer from '../../components/ConfigDrawer.astro';
import ProjectSidebar from '../../components/ProjectSidebar.astro';
import '../../styles/proyecto.css';
import '../../styles/tabla.css';
import '../../styles/tareas.css';
import '../../styles/modales.css';
import '../../styles/sidebar-meses.css';
import '../../styles/project-views.css';

const pageTitle = 'Tablero de Proyecto';

// Los handlers y servicios se importan en el script
// El sidebar se inicializará dinámicamente con los modules_config del proyecto
---

<BaseLayout title={pageTitle}>
  <ProtectedRoute>
    <Header />
    <ConfigDrawer />
    <ProjectSidebar />
    
    <div class="container" id="proyecto-layout">
      <!-- Vista Dashboard (actual tablero) -->
      <div id="view-dashboard" class="project-view active">
      <!-- Header del Proyecto -->
      <div class="proyecto-header">
        <div>
          <h1 id="proyecto-nombre">Cargando...</h1>
          <p id="proyecto-periodo" class="proyecto-periodo"></p>
        </div>
        <div class="header-actions">
          <span id="proyecto-status" class="badge"></span>
          <button id="config-btn" class="btn btn-secondary">⚙️ Configuración</button>
          <button id="ver-todo-btn" class="btn btn-primary-outline">📅 Ver Todo el Mes</button>
          <button id="finalizar-btn" class="btn btn-success">✅ Finalizar</button>
        </div>
      </div>

      <!-- Contenido Principal con Sidebar -->
      <div class="proyecto-wrapper">
        <!-- Sidebar de Meses -->
        <aside class="meses-sidebar">
          <div class="sidebar-header">
            <h3>📅 Meses</h3>
            <p id="proyecto-nombre-sidebar">Cargando...</p>
          </div>

          <button class="add-mes-btn" id="add-mes-btn">+ Agregar mes</button>

          <div class="meses-list" id="meses-list">
            <div class="mes-item loading">Cargando meses...</div>
          </div>

          <div class="mes-info" id="mes-info" style="display: none;">
            <strong>Mes actual:</strong> <span id="mes-info-text"></span>
          </div>
        </aside>

        <!-- Contenido Principal (Tabla + Panel de Tareas) -->
        <div class="proyecto-grid">
        <!-- Columna Izquierda: Tabla de Días -->
        <div class="dias-column">
          <div class="section">
            <h2>📆 Esta Semana</h2>
            
            <div class="table-container">
              <table class="dias-table" id="dias-table">
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Día</th>
                    <th>Horas Trabajadas</th>
                    <th id="th-horas-reales">Horas Reales</th>
                  </tr>
                </thead>
                <tbody id="dias-tbody">
                  <tr class="loading-row">
                    <td colspan="4" class="text-center">Cargando días...</td>
                  </tr>
                </tbody>
                <tfoot>
                  <tr class="totals-row">
                    <td><strong>Total:</strong></td>
                    <td></td>
                    <td><strong id="total-trabajadas">00:00</strong></td>
                    <td id="td-total-reales"><strong id="total-reales">00:00</strong></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Panel de Tareas -->
        <div class="tareas-column">
          <!-- Tarjeta de Proyecto -->
          <div class="section proyecto-card-info">
            <h3 id="card-nombre">ArgentinaMining</h3>
            <p id="card-descripcion" class="card-descripcion">Sin descripción</p>
            <div class="card-badge">
              <span id="card-status" class="badge badge-active">✓ Activo</span>
            </div>
          </div>

          <!-- Panel de Tareas -->
          <div class="section tareas-panel">
            <div class="tareas-header">
              <div class="tareas-title-group">
                <h2>📋 Tareas</h2>
                <span id="tareas-count" class="tareas-badge">0</span>
              </div>
              <button id="nueva-tarea-btn" class="btn btn-small">+</button>
            </div>

            <!-- Lista de Tareas -->
            <div id="tareas-list" class="tareas-list">
              <div class="empty-tareas">
                <p>📭 Sin tareas aún</p>
              </div>
            </div>
          </div>

          <!-- Totales -->
          <div class="section totales-panel">
            <div class="total-item">
              <span>Total:</span>
              <strong id="panel-total-reales" class="total-value">06:00</strong>
            </div>
          </div>

          <!-- Botones Exportar -->
          <button id="exportar-pdf-btn" class="btn btn-danger btn-block">
            📥 Exportar PDF
          </button>
          <button id="exportar-csv-btn" class="btn btn-success btn-block" style="margin-top: 10px;">
            📊 Exportar CSV
          </button>
        </div>
        <!-- Fin tareas-column -->
      </div>
      <!-- Fin proyecto-grid -->
      </div>
      <!-- Fin proyecto-wrapper -->
      </div>
      <!-- Fin view-dashboard -->

      <!-- Vista Colaboradores -->
      <div id="view-colaboradores" class="project-view">
        <div class="colaboradores-container">
          <h1>👥 Gestión de Colaboradores</h1>
          
          <!-- Estado del proyecto -->
          <div class="card" id="estado-proyecto-card">
            <h3>📌 Estado del Proyecto</h3>
            <p>Tipo: <strong id="tipo-proyecto-text">Cargando...</strong></p>
            <button id="btn-convertir-colaborativo" class="btn btn-primary" style="display: none;">
              🔄 Convertir a Colaborativo
            </button>
          </div>

          <!-- Formulario de invitación -->
          <div class="card" id="invitar-colaborador-card" style="display: none;">
            <h3>✉️ Invitar Colaborador</h3>
            <form id="form-invitar-colaborador">
              <div class="form-group">
                <label for="email-colaborador">Email del colaborador</label>
                <input type="email" id="email-colaborador" class="form-input" placeholder="usuario@ejemplo.com" required />
              </div>
              <div class="form-group">
                <label class="checkbox-label">
                  <input type="checkbox" id="horas-reales-colaborador" />
                  <span>Activar horas reales para este colaborador</span>
                </label>
              </div>
              <button type="submit" class="btn btn-primary">📤 Enviar Invitación</button>
            </form>
          </div>

          <!-- Lista de colaboradores -->
          <div class="card" id="lista-colaboradores-card" style="display: none;">
            <h3>📋 Colaboradores Actuales</h3>
            <div id="colaboradores-list">
              <p class="empty-message">Cargando...</p>
            </div>
          </div>

          <!-- Resumen -->
          <div class="card" id="resumen-colaboradores-card" style="display: none;">
            <h3>📊 Resumen General</h3>
            <p class="resumen-descripcion">Estadísticas totales del proyecto colaborativo</p>
            <div class="stats-grid">
              <div class="stat-item">
                <span class="stat-label">Total colaboradores:</span>
                <span class="stat-value" id="total-colaboradores">0</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Total horas del proyecto:</span>
                <span class="stat-value" id="total-horas-colaboradores">0h</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Fin view-colaboradores -->

      <!-- Modal para agregar mes -->
      <div class="add-mes-modal" id="add-mes-modal">
        <form class="add-mes-form" id="add-mes-form">
          <h3>Agregar Nuevo Mes</h3>
          
          <div class="form-group">
            <label for="nuevo-mes-year">Año:</label>
            <input type="number" id="nuevo-mes-year" min="2020" max="2100" required />
          </div>

          <div class="form-group">
            <label for="nuevo-mes-mes">Mes:</label>
            <select id="nuevo-mes-mes" required>
              <option value="">Seleccione un mes</option>
              <option value="1">Enero</option>
              <option value="2">Febrero</option>
              <option value="3">Marzo</option>
              <option value="4">Abril</option>
              <option value="5">Mayo</option>
              <option value="6">Junio</option>
              <option value="7">Julio</option>
              <option value="8">Agosto</option>
              <option value="9">Septiembre</option>
              <option value="10">Octubre</option>
              <option value="11">Noviembre</option>
              <option value="12">Diciembre</option>
            </select>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary">Agregar</button>
            <button type="button" class="btn-secondary" id="close-add-mes">Cancelar</button>
          </div>
        </form>
      </div>
      <div id="mes-modal" class="modal" style="display: none;">
        <div class="modal-content modal-large">
          <div class="modal-header">
            <h3 id="mes-modal-title">Noviembre 2025</h3>
            <button class="modal-close" id="mes-modal-close">✕</button>
          </div>
          <div class="selection-controls-container" id="mes-section-selection-controls" style="display: none;">
            <div class="selection-info">
              <span class="selection-count" id="mes-section-selection-count">0 días seleccionados</span>
            </div>
            <div class="selection-actions">
              <button class="selection-btn selection-btn-create" id="mes-section-btn-create-task">
                ✅ Crear tarea
              </button>
              <button class="selection-btn selection-btn-cancel" id="mes-section-btn-cancel">
                ✖ Cancelar
              </button>
            </div>
          </div>
          <div class="mes-modal-body">
            <div class="table-container">
              <table class="dias-table" id="mes-dias-table">
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Día</th>
                    <th>Horas Trabajadas</th>
                    <th id="th-mes-horas-reales">Horas Reales</th>
                  </tr>
                </thead>
                <tbody id="mes-dias-tbody">
                  <tr class="loading-row">
                    <td colspan="4" class="text-center">Cargando días...</td>
                  </tr>
                </tbody>
                <tfoot>
                  <tr class="totals-row">
                    <td><strong>Total del Mes:</strong></td>
                    <td></td>
                    <td><strong id="mes-total-trabajadas">00:00</strong></td>
                    <td id="td-mes-total-reales"><strong id="mes-total-reales">00:00</strong></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" id="mes-modal-close-btn">Cerrar</button>
          </div>
        </div>
      </div>

      <!-- Modal para visualizar tarea -->
      <div id="view-tarea-modal" class="modal" style="display: none;">
        <div class="modal-content modal-tarea">
          <div class="modal-header">
            <h3 id="view-modal-title">Detalle de Tarea</h3>
            <button class="modal-close" id="view-modal-close">✕</button>
          </div>
          <div class="modal-body" id="view-modal-body">
            <!-- Contenido dinámico -->
          </div>
          <div class="modal-footer">
            <button class="btn btn-primary" id="edit-from-view-btn">✏️ Editar</button>
            <button class="btn btn-danger" id="delete-from-view-btn">🗑️ Eliminar</button>
            <button class="btn btn-secondary" id="view-modal-close-btn">Cerrar</button>
          </div>
        </div>
      </div>

      <!-- Modal para nueva tarea -->
      <div id="tarea-modal" class="modal" style="display: none;">
        <div class="modal-content">
          <div class="modal-header">
            <h3 id="modal-title">Nueva Tarea</h3>
            <button class="modal-close" id="modal-close">✕</button>
          </div>
          <form id="tarea-form">
            <div class="form-group">
              <label>Título *</label>
              <input type="text" id="tarea-titulo" required />
            </div>
            <div class="form-group">
              <label>Detalle</label>
              <textarea id="tarea-detalle" rows="3"></textarea>
            </div>
            <div class="form-group">
              <label>¿Qué falta?</label>
              <textarea id="tarea-que-falta" rows="2"></textarea>
            </div>
            <div class="form-group">
              <label>Seleccionar Días</label>
              <div class="dias-selector">
                <div id="dias-selected" class="dias-selected"></div>
                <select id="dias-select" class="dias-select">
                  <option value="">Seleccione los días</option>
                </select>
                
              </div>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Crear Tarea</button>
              <button type="button" class="btn btn-secondary" id="modal-cancel">Cancelar</button>
            </div>
          </form>
        </div>
      </div>

      <div id="error-message" class="alert alert-error" style="display: none;"></div>

<script>
  import { AuthService } from '../../services/auth';
  import { ProyectosService } from '../../services/proyectos';
  import { proyectoHandlers } from '../../handlers/proyecto';
  import { TareaService } from '../../services/tarea';
  import { generatePDFFromTemplate } from '../../utils/pdf';
  import { MESES_ES } from '../../utils/formatters';
  import { AlertUtils } from '../../utils/swal';
  import { TareaHandler } from '../../handlers/tarea';
  import { MesesHandler } from '../../handlers/meses';
  import { ColaboradoresHandler } from '../../handlers/colaboradores';

  // Verificar autenticación
  if (!AuthService.isAuthenticated()) {
    window.location.href = '/login';
  }

  // Exponer handlers globalmente
  (window as any).proyectoHandlers = proyectoHandlers;

  // Referencias a modales y elementos
  const modal = document.getElementById('tarea-modal')!;
  const mesModal = document.getElementById('mes-modal')!;
  const form = document.getElementById('tarea-form') as HTMLFormElement;
  const diasSelect = document.getElementById('dias-select') as HTMLSelectElement;
  const diasSelectedDiv = document.getElementById('dias-selected')!;

  // ========== GESTIÓN DE VISTAS ==========
  
  // Función para cambiar entre vistas
  function cambiarVista(vistaId: string) {
    // Ocultar todas las vistas
    const vistas = document.querySelectorAll('.project-view');
    vistas.forEach(vista => (vista as HTMLElement).style.display = 'none');
    
    // Mostrar vista seleccionada
    const vistaActiva = document.getElementById(`view-${vistaId}`);
    if (vistaActiva) {
      vistaActiva.style.display = 'block';
      
      // Si es la vista de colaboradores, inicializar
      if (vistaId === 'colaboradores') {
        const proyectoId = parseInt(window.location.pathname.split('/')[2]);
        if (proyectoId) {
          ColaboradoresHandler.init(proyectoId);
        }
      }
    }
  }
  
  // Manejar clicks en items del menú del sidebar
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const menuItem = target.closest('.menu-item');
    
    if (menuItem) {
      const vista = (menuItem as HTMLElement).dataset.view;
      if (vista && (vista === 'dashboard' || vista === 'colaboradores')) {
        e.preventDefault();
        cambiarVista(vista);
        
        // Actualizar clases active
        document.querySelectorAll('.menu-item').forEach(item => item.classList.remove('active'));
        menuItem.classList.add('active');
      }
    }
  });
  
  // Iniciar en vista dashboard
  cambiarVista('dashboard');

  // ========== GESTIÓN DE TAREAS ==========

  // Nueva tarea
  document.getElementById('nueva-tarea-btn')?.addEventListener('click', async () => {
    TareaHandler.resetParaCrear(form);
    const proyecto = proyectoHandlers.state.proyectoActual;
    if (proyecto) {
      await TareaHandler.loadDiasDisponibles(proyecto.id, proyecto.anio, proyecto.mes);
    }
    modal.style.display = 'flex';
  });

  // Cerrar modales de tareas
  document.getElementById('modal-close')?.addEventListener('click', () => {
    modal.style.display = 'none';
  });
  document.getElementById('modal-cancel')?.addEventListener('click', () => {
    modal.style.display = 'none';
  });
  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.style.display = 'none';
  });

  // Seleccionar días
  diasSelect.addEventListener('change', () => {
    if (diasSelect.value) {
      const diaId = parseInt(diasSelect.value);
      const dia = TareaHandler.diasDisponibles.get(diaId);
      if (dia) {
        TareaHandler.diasSeleccionados.set(diaId, dia);
        TareaHandler.actualizarSelectDias(diasSelect);
        TareaHandler.renderizarDiasSeleccionados(diasSelectedDiv);
        diasSelect.value = '';
      }
    }
  });

  // Guardar tarea (crear o actualizar)
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const proyecto = proyectoHandlers.state.proyectoActual;
    if (proyecto) {
      // Cerrar modal ANTES de guardar para que el SweetAlert aparezca correctamente
      modal.style.display = 'none';

      const success = await TareaHandler.guardarTarea(form, proyecto.id, async () => {
        TareaHandler.diasSeleccionados.clear();
        await proyectoHandlers.loadTareas();
      });
      
      if (success) {
        TareaHandler.renderizarDiasSeleccionados(diasSelectedDiv);
      } else {
        // Si falló, reabrir el modal
        modal.style.display = 'flex';
      }
    }
  });

  // Visualizar tarea
  document.addEventListener('view-tarea', (event: any) => {
    const tarea = event.detail.tarea;
    TareaHandler.tareaEnVista = tarea;
    const usaHorasReales = proyectoHandlers.state.proyectoActual?.horas_reales_activas || false;
    TareaHandler.renderizarVistaDetalle(tarea, usaHorasReales);
    document.getElementById('view-tarea-modal')!.style.display = 'flex';
  });

  // Cerrar modal de visualización
  document.getElementById('view-modal-close')?.addEventListener('click', () => {
    document.getElementById('view-tarea-modal')!.style.display = 'none';
  });
  document.getElementById('view-modal-close-btn')?.addEventListener('click', () => {
    document.getElementById('view-tarea-modal')!.style.display = 'none';
  });

  // Editar desde visualización
  document.getElementById('edit-from-view-btn')?.addEventListener('click', async () => {
    document.getElementById('view-tarea-modal')!.style.display = 'none';
    if (TareaHandler.tareaEnVista) {
      const proyecto = proyectoHandlers.state.proyectoActual;
      if (proyecto) {
        await TareaHandler.cargarParaEditar(
          TareaHandler.tareaEnVista,
          proyecto.id,
          proyecto.anio,
          proyecto.mes
        );
        modal.style.display = 'flex';
      }
    }
  });

  // Crear tarea con días pre-seleccionados desde multi-select
  document.addEventListener('create-tarea-with-dias', async (event: any) => {
    const diaIds = event.detail.diaIds as number[];
    const proyecto = proyectoHandlers.state.proyectoActual;
    if (proyecto && diaIds && diaIds.length > 0) {
      // Cargar días disponibles
      await TareaHandler.loadDiasDisponibles(
        proyecto.id,
        proyecto.anio,
        proyecto.mes
      );
      
      // Resetear formulario con días pre-seleccionados
      TareaHandler.resetParaCrear(form, diaIds);
      
      // Abrir modal
      modal.style.display = 'flex';
    }
  });

  // Eliminar desde visualización
  document.getElementById('delete-from-view-btn')?.addEventListener('click', async () => {
    if (TareaHandler.tareaEnVista) {
      document.getElementById('view-tarea-modal')!.style.display = 'none';
      await TareaHandler.eliminarTarea(
        TareaHandler.tareaEnVista.id,
        TareaHandler.tareaEnVista.titulo,
        async () => {
          await proyectoHandlers.loadTareas();
        }
      );
    }
  });

  // ========== GESTIÓN DE MESES ==========

  // Modal de mes (ver todo)
  document.getElementById('ver-todo-btn')?.addEventListener('click', () => {
    const proyecto = proyectoHandlers.state.proyectoActual;
    if (proyecto) {
      const mesModalTitle = document.getElementById('mes-modal-title');
      if (mesModalTitle) {
        const mesNombre = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'][proyecto.mes - 1];
        mesModalTitle.textContent = `${mesNombre} ${proyecto.anio}`;
      }
    }
    mesModal.style.display = 'flex';
  });

  document.getElementById('mes-modal-close')?.addEventListener('click', () => {
    mesModal.style.display = 'none';
  });

  document.getElementById('mes-modal-close-btn')?.addEventListener('click', () => {
    mesModal.style.display = 'none';
  });

  mesModal.addEventListener('click', (e) => {
    if (e.target === mesModal) mesModal.style.display = 'none';
  });

  // Agregar mes
  document.getElementById('add-mes-btn')?.addEventListener('click', () => {
    MesesHandler.openAddMesModal();
  });

  document.getElementById('close-add-mes')?.addEventListener('click', () => {
    MesesHandler.closeAddMesModal();
  });

  document.getElementById('add-mes-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('add-mes-modal')) {
      MesesHandler.closeAddMesModal();
    }
  });

  // Formulario agregar mes
  document.getElementById('add-mes-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    try {
      const anio = parseInt((document.getElementById('nuevo-mes-year') as HTMLInputElement).value);
      const mes = parseInt((document.getElementById('nuevo-mes-mes') as HTMLSelectElement).value);

      if (!anio || !mes) {
        await AlertUtils.error('Error', 'Por favor seleccione un mes y año válidos');
        return;
      }

      const fechaSeleccionada = new Date(anio, mes - 1, 1);
      const hoy = new Date();
      hoy.setHours(0, 0, 0, 0);

      if (fechaSeleccionada < hoy) {
        const result = await AlertUtils.question(
          '¿Deseas continuar?',
          'La fecha seleccionada es anterior a hoy.'
        );
        if (result.isConfirmed) {
          const proyecto = proyectoHandlers.state.proyectoActual;
          if (proyecto) await MesesHandler.agregarMes(proyecto.id, anio, mes);
        }
      } else {
        const proyecto = proyectoHandlers.state.proyectoActual;
        if (proyecto) await MesesHandler.agregarMes(proyecto.id, anio, mes);
      }
    } catch (error) {
      console.error('Error:', error);
      await AlertUtils.error('Error', 'No se pudo agregar el mes');
    }
  });

  // Evento cuando se selecciona un mes
  document.addEventListener('mes-selected', async (event: any) => {
    const { anio, mes } = event.detail;
    const proyecto = proyectoHandlers.state.proyectoActual;

    if (proyecto) {
      const mesCreado = await MesesHandler.crearMesAutomatico(proyecto.id, anio, mes);

      if (!mesCreado) {
        await AlertUtils.error('Error', 'No se pudo crear el mes automáticamente');
        return;
      }

      // Actualizar proyecto
      proyecto.anio = anio;
      proyecto.mes = mes;
      proyectoHandlers.state.mesActual = mes;
      proyectoHandlers.state.anioActual = anio;

      // Recargar datos
      await proyectoHandlers.loadDias();
      await proyectoHandlers.loadTareas();
      proyectoHandlers.updateTotalPanel();

      // Actualizar UI
      const periodoEl = document.getElementById('proyecto-periodo');
      if (periodoEl) {
        const hoy = new Date();
        const mesActualReal = hoy.getMonth() + 1;
        const anioActualReal = hoy.getFullYear();
        const esMesPasado = anio < anioActualReal || (anio === anioActualReal && mes < mesActualReal);
        
        if (esMesPasado) {
          periodoEl.innerHTML = `${MESES_ES[mes as keyof typeof MESES_ES]} ${anio} <span style="margin-left: 8px; padding: 2px 8px; background: #555; border-radius: 4px; font-size: 0.75rem;">✓ Terminado</span>`;
        } else {
          periodoEl.textContent = `${MESES_ES[mes as keyof typeof MESES_ES]} ${anio}`;
        }
      }

      // renderMeses recibe el mes seleccionado (para marcarlo con check)
      MesesHandler.renderMeses({ anio, mes });
      // updateMesInfo siempre muestra el mes actual real del sistema
      MesesHandler.updateMesInfo();
    }
  });

  // ========== ACCIONES GENERALES ==========

  // Exportar PDF
  document.getElementById('exportar-pdf-btn')?.addEventListener('click', async () => {
    try {
      const proyecto = proyectoHandlers.state.proyectoActual;
      if (!proyecto) {
        await AlertUtils.error('Error', 'Proyecto no disponible');
        return;
      }

      const mes = MESES_ES[proyecto.mes as keyof typeof MESES_ES] || `Mes ${proyecto.mes}`;

      AlertUtils.loading('Generando PDF...');
      try {
        // Si es proyecto colaborativo, obtener datos de todos los colaboradores
        if (proyecto.tipo_proyecto === 'colaborativo') {
          const colaboradoresData = await ProyectosService.getExportColaboradores(
            proyecto.id,
            proyecto.mes,
            proyecto.anio
          );

          if (colaboradoresData.colaboradores.length === 0) {
            AlertUtils.close();
            await AlertUtils.info('Información', 'No hay colaboradores con tareas para exportar');
            return;
          }

          await generatePDFFromTemplate(
            proyecto.nombre,
            mes,
            proyecto.anio,
            [],
            [],
            true, // isColaborativo
            colaboradoresData
          );
        } else {
          // Proyecto no colaborativo: usar lógica original
          const tareas = proyectoHandlers.state.tareasActuales;

          if (tareas.length === 0) {
            AlertUtils.close();
            await AlertUtils.info('Información', 'No hay tareas para exportar');
            return;
          }

          await generatePDFFromTemplate(
            proyecto.nombre,
            mes,
            proyecto.anio,
            tareas,
            proyectoHandlers.state.diasActuales,
            false // No colaborativo
          );
        }

        AlertUtils.close();
        await AlertUtils.success('Éxito', 'PDF descargado correctamente');
      } catch (error) {
        console.error('Error generando PDF:', error);
        AlertUtils.close();
        await AlertUtils.error('Error', 'No se pudo generar el PDF');
      }
    } catch (error) {
      console.error('Error:', error);
      await AlertUtils.error('Error', 'Error al exportar PDF');
    }
  });

  // Botón Exportar CSV
  document.getElementById('exportar-csv-btn')?.addEventListener('click', async () => {
    try {
      const proyecto = proyectoHandlers.state.proyectoActual;
      if (!proyecto) {
        await AlertUtils.error('Error', 'Proyecto no disponible');
        return;
      }

      const mes = MESES_ES[proyecto.mes as keyof typeof MESES_ES] || `Mes ${proyecto.mes}`;
      const tareas = proyectoHandlers.state.tareasActuales;

      if (tareas.length === 0) {
        await AlertUtils.info('Información', 'No hay tareas para exportar');
        return;
      }

      AlertUtils.loading('Generando CSV...');
      try {
        // Crear contenido CSV
        const headers = ['Tarea', 'Detalle', 'Horas', 'Días', 'Estado'];
        const rows = tareas.map(tarea => {
          const diasTarea = tarea.dias || [];
          const diasAsociados = diasTarea.length > 0
            ? diasTarea.map(d => new Date(d.fecha).getDate()).join('; ')
            : '-';
          
          return [
            tarea.titulo || '-',
            (tarea.detalle || '-').replace(/,/g, ';').replace(/\n/g, ' '),
            tarea.horas || '00:00',
            diasAsociados,
            tarea.completada ? 'Completada' : 'Pendiente'
          ];
        });

        // Calcular total de horas
        const totalHoras = tareas.reduce((sum, t) => {
          const [horas, minutos] = (t.horas || '00:00').split(':').map(Number);
          return sum + (horas || 0) + (minutos || 0) / 60;
        }, 0);
        const horasTotal = Math.floor(totalHoras);
        const minutosTotal = Math.round((totalHoras - horasTotal) * 60);
        const totalFormateado = `${horasTotal}:${minutosTotal.toString().padStart(2, '0')}`;

        // Agregar fila de total
        rows.push(['', '', totalFormateado, '', '']);
        rows.unshift(headers);

        // Convertir a CSV
        const csvContent = rows.map(row => 
          row.map(cell => {
            const cellStr = String(cell);
            // Escapar comillas y envolver en comillas si contiene comas, saltos de línea o comillas
            if (cellStr.includes(',') || cellStr.includes('"') || cellStr.includes('\n')) {
              return `"${cellStr.replace(/"/g, '""')}"`;
            }
            return cellStr;
          }).join(',')
        ).join('\n');

        // Crear y descargar el archivo
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        link.setAttribute('download', `${proyecto.nombre}-${mes}-${proyecto.anio}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        AlertUtils.close();
        await AlertUtils.success('Éxito', 'CSV descargado correctamente');
      } catch (error) {
        console.error('Error generando CSV:', error);
        AlertUtils.close();
        await AlertUtils.error('Error', 'No se pudo generar el CSV');
      }
    } catch (error) {
      console.error('Error:', error);
      await AlertUtils.error('Error', 'Error al exportar CSV');
    }
  });

  // Botón de Configuración - Abrir drawer
  document.getElementById('config-btn')?.addEventListener('click', async () => {
    const proyecto = proyectoHandlers.state.proyectoActual;
    if (proyecto) {
      const { ConfigDrawerHandler } = await import('../../handlers/config-drawer');
      const drawer = new ConfigDrawerHandler(proyecto.id);
      await drawer.open();
    }
  });

  // Finalizar o Reactivar proyecto
  document.getElementById('finalizar-btn')?.addEventListener('click', async () => {
    const proyecto = proyectoHandlers.state.proyectoActual;
    if (!proyecto) return;

    const isActive = proyecto.activo;
    const action = isActive ? 'Finalizar' : 'Reactivar';

    const result = await AlertUtils.confirm(
      `¿${action} proyecto?`,
      isActive
        ? 'Esto marcará el proyecto como inactivo'
        : 'Esto reactivará el proyecto',
      `Sí, ${action.toLowerCase()}`,
      'Cancelar'
    );

    if (result.isConfirmed) {
      try {
        await ProyectosService.cambiarEstado(proyecto.id, !isActive);
        await proyectoHandlers.loadProyecto();
        await AlertUtils.success('Éxito', `Proyecto ${action.toLowerCase()}do correctamente`);
      } catch (error) {
        await AlertUtils.error('Error', `No se pudo ${action.toLowerCase()} el proyecto`);
      }
    }
  });

  // ========== INICIALIZACIÓN ==========

  // Inicializar al cargar la página
  proyectoHandlers.loadProyecto().then(async () => {
    const proyecto = proyectoHandlers.state.proyectoActual;
    if (proyecto) {
      // Cargar meses
      await MesesHandler.loadMeses(proyecto.id);
      // Renderizar meses marcando el mes del proyecto como seleccionado
      MesesHandler.renderMeses({ anio: proyecto.anio, mes: proyecto.mes });
      // updateMesInfo siempre muestra el mes actual real del sistema
      MesesHandler.updateMesInfo();
      
      // Actualizar sidebar con tipo de proyecto
      if ((window as any).updateSidebarModules) {
        (window as any).updateSidebarModules(proyecto.modules_config || {}, proyecto.id, proyecto.tipo_proyecto);
      }

      // Actualizar nombre del sidebar
      const sidebarNombre = document.getElementById('proyecto-nombre-sidebar');
      if (sidebarNombre) sidebarNombre.textContent = proyecto.nombre;

      // Actualizar módulos del sidebar según configuración del proyecto
      if (typeof (window as any).updateSidebarModules === 'function') {
        (window as any).updateSidebarModules(proyecto.modules_config || {}, proyecto.id, proyecto.tipo_proyecto);
      }
    }
    
    // Inicializar modo de selección múltiple
    proyectoHandlers.initMultiSelect();
  });

  // Gestión de vistas (Dashboard, Colaboradores, etc)
  const menuItems = document.querySelectorAll('.menu-item');
  const views = {
    'dashboard': document.getElementById('view-dashboard'),
    'colaboradores': document.getElementById('view-colaboradores'),
  };

  menuItems.forEach(item => {
    const link = item.querySelector('a');
    if (!link) return;

    item.addEventListener('click', async (e) => {
      const view = (item as HTMLElement).dataset.view;
      if (!view || !views[view as keyof typeof views]) return;

      // Si tiene href y no es #, dejar que navegue normal
      if (link.getAttribute('href') !== '#') return;

      e.preventDefault();

      // Ocultar todas las vistas
      Object.values(views).forEach(v => v?.classList.remove('active'));

      // Mostrar la vista seleccionada
      views[view as keyof typeof views]?.classList.add('active');

      // Actualizar menú activo
      menuItems.forEach(mi => mi.classList.remove('active'));
      item.classList.add('active');

      // Si es colaboradores, inicializar
      if (view === 'colaboradores') {
        const proyectoId = parseInt(window.location.pathname.split('/')[2]);
        const { ColaboradoresHandler } = await import('../../handlers/colaboradores');
        await ColaboradoresHandler.init(proyectoId);
      }
    });
  });

  // Limpiar al salir
  window.addEventListener('beforeunload', () => {
    proyectoHandlers.cleanupMultiSelect();
  });

  // Inicializar handler de vistas
  const { ProjectViewHandler } = await import('../../handlers/project-view');
  const currentProyecto = proyectoHandlers.state.proyectoActual;
  if (currentProyecto) {
    const viewHandler = new ProjectViewHandler(currentProyecto.id);
    (window as any).viewHandler = viewHandler;
  }

</script>

