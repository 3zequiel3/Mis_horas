---
/**
 * Página de Auditoría y Trazabilidad del Proyecto
 * Sistema de Gobierno y Seguridad - Fase 2
 * NOTA: Esta página ahora usa el sistema de diseño TimeFlow
 * Los estilos están en: /src/styles/auditoria.css
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import ProtectedRoute from '../../../components/ProtectedRoute.astro';
import '../../../styles/auditoria.css';

const { id } = Astro.params;
const proyectoId = parseInt(id || '0');

const title = `Auditoría - Proyecto ${proyectoId}`;
---

<BaseLayout title={title}>
  <ProtectedRoute />
  <Header />

  <main class="auditoria-container">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Auditoría y Trazabilidad</h1>
          <p class="mt-2 text-gray-600">Registro completo de actividades y cambios en el sistema</p>
        </div>
        <div class="flex gap-3">
          <button
            id="btn-stats"
            class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            Estadísticas
          </button>
          <button
            id="btn-export"
            class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            Exportar
          </button>
        </div>
      </div>
    </div>

    <!-- Mensajes -->
    <div id="message-container"></div>

    <!-- Filtros -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900">Filtros</h2>
        <button
          id="btn-clear-filters"
          class="text-sm text-indigo-600 hover:text-indigo-700 font-medium"
        >
          Limpiar filtros
        </button>
      </div>

      <form id="filter-form" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <label for="filter-start-date" class="block text-sm font-medium text-gray-700 mb-1">Fecha inicio</label>
          <input
            type="date"
            id="filter-start-date"
            class="block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
          >
        </div>

        <div>
          <label for="filter-end-date" class="block text-sm font-medium text-gray-700 mb-1">Fecha fin</label>
          <input
            type="date"
            id="filter-end-date"
            class="block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
          >
        </div>

        <div>
          <label for="filter-category" class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
          <select
            id="filter-category"
            class="block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
          >
            <option value="">Todas</option>
            <option value="organization">Organización</option>
            <option value="user">Usuario</option>
            <option value="project">Proyecto</option>
            <option value="time">Tiempo</option>
            <option value="task">Tarea</option>
            <option value="employee">Personal</option>
            <option value="financial">Financiero</option>
            <option value="security">Seguridad</option>
            <option value="system">Sistema</option>
          </select>
        </div>

        <div>
          <label for="filter-severity" class="block text-sm font-medium text-gray-700 mb-1">Severidad</label>
          <select
            id="filter-severity"
            class="block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
          >
            <option value="">Todas</option>
            <option value="info">Info</option>
            <option value="warning">Advertencia</option>
            <option value="error">Error</option>
            <option value="critical">Crítico</option>
          </select>
        </div>

        <div class="lg:col-span-4">
          <button
            type="submit"
            class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            Aplicar filtros
          </button>
        </div>
      </form>
    </div>

    <!-- Loading -->
    <div id="loading-state" class="text-center py-12">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mx-auto"></div>
      <p class="mt-4 text-gray-600">Cargando registros de auditoría...</p>
    </div>

    <!-- Tabla de logs -->
    <div id="logs-container" class="hidden">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha/Hora</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Usuario</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acción</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Categoría</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recurso</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Severidad</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
              </tr>
            </thead>
            <tbody id="logs-tbody" class="bg-white divide-y divide-gray-200">
              <!-- Se llenará dinámicamente -->
            </tbody>
          </table>
        </div>

        <!-- Paginación -->
        <div class="bg-gray-50 px-4 py-3 border-t border-gray-200 sm:px-6">
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-700">
              Mostrando <span id="page-info-start" class="font-medium">0</span> a <span id="page-info-end" class="font-medium">0</span> de <span id="page-info-total" class="font-medium">0</span> registros
            </div>
            <div class="flex gap-2">
              <button
                id="btn-prev-page"
                class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Anterior
              </button>
              <button
                id="btn-next-page"
                class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Siguiente
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Estado vacío -->
    <div id="empty-state" class="hidden text-center py-12 bg-white rounded-lg shadow-sm border border-gray-200">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No hay registros</h3>
      <p class="mt-1 text-sm text-gray-500">No se encontraron registros de auditoría con los filtros aplicados.</p>
    </div>
  </main>

  <!-- Modal: Detalles del Log -->
  <div id="modal-details" class="fixed z-10 inset-0 overflow-y-auto hidden" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
      
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-3xl sm:w-full">
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Detalles del Registro de Auditoría</h3>
            <button id="btn-close-details" class="text-gray-400 hover:text-gray-500">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <div id="details-content" class="space-y-4">
            <!-- Se llenará dinámicamente -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Estadísticas -->
  <div id="modal-stats" class="fixed z-10 inset-0 overflow-y-auto hidden" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
      
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full">
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6">
          <div class="flex justify-between items-start mb-6">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Estadísticas de Auditoría</h3>
            <button id="btn-close-stats" class="text-gray-400 hover:text-gray-500">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <div id="stats-content" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Se llenará dinámicamente -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Exportar -->
  <div id="modal-export" class="fixed z-10 inset-0 overflow-y-auto hidden" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
      
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Exportar Registros de Auditoría</h3>
          
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Formato de exportación</label>
              <div class="space-y-2">
                <label class="inline-flex items-center">
                  <input type="radio" name="export-format" value="json" checked class="form-radio text-indigo-600">
                  <span class="ml-2">JSON</span>
                </label>
                <label class="inline-flex items-center ml-6">
                  <input type="radio" name="export-format" value="csv" class="form-radio text-indigo-600">
                  <span class="ml-2">CSV</span>
                </label>
              </div>
            </div>

            <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm text-yellow-700">
                    Se exportarán los registros según los filtros actualmente aplicados.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-5 sm:mt-6 sm:grid sm:grid-cols-2 sm:gap-3 sm:grid-flow-row-dense">
            <button
              id="btn-confirm-export"
              class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-indigo-600 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none sm:col-start-2 sm:text-sm"
            >
              Exportar
            </button>
            <button
              id="btn-cancel-export"
              class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:col-start-1 sm:text-sm"
            >
              Cancelar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { auditService } from '../../../services/auditService';
    import type { AuditLog, AuditLogFilters } from '../../../types/audit';

    // Obtener proyecto_id de la URL
    const pathParts = window.location.pathname.split('/');
    const proyectoId = parseInt(pathParts[2]);

    let currentFilters: AuditLogFilters = { 
      page: 1, 
      per_page: 50,
      proyecto_id: proyectoId 
    };
    let currentPage = 1;
    let totalPages = 1;

    // Cargar logs
    async function loadLogs() {
      const loading = document.getElementById('loading-state');
      const container = document.getElementById('logs-container');
      const empty = document.getElementById('empty-state');

      try {
        // Debug
        const token = localStorage.getItem('token');
        const orgId = localStorage.getItem('currentOrganizationId');
        console.log('Debug - Token presente:', !!token, 'OrgId:', orgId, 'ProyectoId:', proyectoId);
        
        if (loading) loading.classList.remove('hidden');
        if (container) container.classList.add('hidden');
        if (empty) empty.classList.add('hidden');

        const response = await auditService.getLogs(currentFilters);
        
        if (loading) loading.classList.add('hidden');

        if (response.logs.length === 0) {
          if (empty) empty.classList.remove('hidden');
        } else {
          if (container) container.classList.remove('hidden');
          renderLogs(response.logs);
          updatePagination(response.pagination);
        }
      } catch (error) {
        console.error('Error al cargar logs:', error);
        showMessage('Error al cargar registros de auditoría', 'error');
        if (loading) loading.classList.add('hidden');
      }
    }

    // Renderizar logs
    function renderLogs(logs: AuditLog[]) {
      const tbody = document.getElementById('logs-tbody');
      if (!tbody) return;

      tbody.innerHTML = logs.map(log => {
        const severityColors = {
          info: 'bg-blue-100 text-blue-800',
          warning: 'bg-yellow-100 text-yellow-800',
          error: 'bg-red-100 text-red-800',
          critical: 'bg-purple-100 text-purple-800'
        };

        const categoryLabels: Record<string, string> = {
          organization: 'Organización',
          user: 'Usuario',
          project: 'Proyecto',
          time: 'Tiempo',
          task: 'Tarea',
          employee: 'Personal',
          financial: 'Financiero',
          security: 'Seguridad',
          system: 'Sistema'
        };

        return `
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              ${new Date(log.created_at).toLocaleString('es-ES')}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900">${log.user?.nombre || 'Sistema'}</div>
              <div class="text-sm text-gray-500">${log.user?.email || ''}</div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-900">${formatAction(log.action)}</div>
              <div class="text-sm text-gray-500 truncate max-w-xs">${log.description}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                ${categoryLabels[log.action_category] || log.action_category}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900">${log.resource_type || '-'}</div>
              ${log.resource_name ? `<div class="text-sm text-gray-500">${log.resource_name}</div>` : ''}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${severityColors[log.severity]}">
                ${log.severity.toUpperCase()}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <button
                onclick="viewDetails(${log.id})"
                class="text-indigo-600 hover:text-indigo-900"
              >
                Ver detalles
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function formatAction(action: string): string {
      return action
        .split('_')
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
    }

    // Ver detalles
    (window as any).viewDetails = async (logId: number) => {
      // Buscar el log en los datos actuales
      const tbody = document.getElementById('logs-tbody');
      if (!tbody) return;

      const modal = document.getElementById('modal-details');
      const content = document.getElementById('details-content');
      if (!modal || !content) return;

      // Por simplicidad, mostramos los datos que ya tenemos
      // En producción, haríamos una llamada al backend para obtener detalles completos
      modal.classList.remove('hidden');
    };

    // Actualizar paginación
    function updatePagination(pagination: any) {
      const start = document.getElementById('page-info-start');
      const end = document.getElementById('page-info-end');
      const total = document.getElementById('page-info-total');
      const btnPrev = document.getElementById('btn-prev-page') as HTMLButtonElement;
      const btnNext = document.getElementById('btn-next-page') as HTMLButtonElement;

      if (start) start.textContent = ((pagination.page - 1) * pagination.per_page + 1).toString();
      if (end) end.textContent = Math.min(pagination.page * pagination.per_page, pagination.total).toString();
      if (total) total.textContent = pagination.total.toString();

      currentPage = pagination.page;
      totalPages = pagination.total_pages;

      if (btnPrev) btnPrev.disabled = currentPage <= 1;
      if (btnNext) btnNext.disabled = currentPage >= totalPages;
    }

    // Aplicar filtros
    document.getElementById('filter-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const startDate = (document.getElementById('filter-start-date') as HTMLInputElement)?.value;
      const endDate = (document.getElementById('filter-end-date') as HTMLInputElement)?.value;
      const category = (document.getElementById('filter-category') as HTMLSelectElement)?.value;
      const severity = (document.getElementById('filter-severity') as HTMLSelectElement)?.value;

      currentFilters = {
        page: 1,
        per_page: 50,
        ...(startDate && { start_date: startDate }),
        ...(endDate && { end_date: endDate }),
        ...(category && { category: category as any }),
        ...(severity && { severity: severity as any }),
      };

      loadLogs();
    });

    // Limpiar filtros
    document.getElementById('btn-clear-filters')?.addEventListener('click', () => {
      (document.getElementById('filter-form') as HTMLFormElement)?.reset();
      currentFilters = { page: 1, per_page: 50 };
      loadLogs();
    });

    // Paginación
    document.getElementById('btn-prev-page')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentFilters.page = currentPage - 1;
        loadLogs();
      }
    });

    document.getElementById('btn-next-page')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentFilters.page = currentPage + 1;
        loadLogs();
      }
    });

    // Estadísticas
    document.getElementById('btn-stats')?.addEventListener('click', async () => {
      const modal = document.getElementById('modal-stats');
      const content = document.getElementById('stats-content');
      if (!modal || !content) return;

      try {
        const stats = await auditService.getStatistics();
        
        content.innerHTML = `
          <div class="bg-gray-50 p-4 rounded-lg">
            <h4 class="text-sm font-medium text-gray-900 mb-3">Por Categoría</h4>
            <div class="space-y-2">
              ${Object.entries(stats.by_category).map(([cat, count]) => `
                <div class="flex justify-between items-center">
                  <span class="text-sm text-gray-600">${cat}</span>
                  <span class="text-sm font-semibold text-gray-900">${count}</span>
                </div>
              `).join('')}
            </div>
          </div>

          <div class="bg-gray-50 p-4 rounded-lg">
            <h4 class="text-sm font-medium text-gray-900 mb-3">Por Severidad</h4>
            <div class="space-y-2">
              ${Object.entries(stats.by_severity).map(([sev, count]) => `
                <div class="flex justify-between items-center">
                  <span class="text-sm text-gray-600">${sev}</span>
                  <span class="text-sm font-semibold text-gray-900">${count}</span>
                </div>
              `).join('')}
            </div>
          </div>
        `;

        modal.classList.remove('hidden');
      } catch (error) {
        showMessage('Error al cargar estadísticas', 'error');
      }
    });

    // Exportar
    document.getElementById('btn-export')?.addEventListener('click', () => {
      document.getElementById('modal-export')?.classList.remove('hidden');
    });

    document.getElementById('btn-confirm-export')?.addEventListener('click', async () => {
      const format = (document.querySelector('input[name="export-format"]:checked') as HTMLInputElement)?.value as 'json' | 'csv';
      
      try {
        const blob = await auditService.exportLogs(currentFilters, format);
        
        // Descargar archivo
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `audit-logs-${new Date().toISOString()}.${format}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(url);
        
        document.getElementById('modal-export')?.classList.add('hidden');
        showMessage('Exportación completada', 'success');
      } catch (error) {
        showMessage('Error al exportar registros', 'error');
      }
    });

    // Cerrar modales
    document.getElementById('btn-close-details')?.addEventListener('click', () => {
      document.getElementById('modal-details')?.classList.add('hidden');
    });

    document.getElementById('btn-close-stats')?.addEventListener('click', () => {
      document.getElementById('modal-stats')?.classList.add('hidden');
    });

    document.getElementById('btn-cancel-export')?.addEventListener('click', () => {
      document.getElementById('modal-export')?.classList.add('hidden');
    });

    // Mostrar mensaje
    function showMessage(message: string, type: 'success' | 'error') {
      const container = document.getElementById('message-container');
      if (!container) return;

      const bgColor = type === 'success' ? 'bg-green-50 border-green-200 text-green-800' : 'bg-red-50 border-red-200 text-red-800';
      
      container.innerHTML = `
        <div class="${bgColor} border px-4 py-3 rounded-md mb-4">
          <p class="text-sm font-medium">${message}</p>
        </div>
      `;

      setTimeout(() => {
        container.innerHTML = '';
      }, 5000);
    }

    // Esperar a que la autenticación esté verificada
    window.addEventListener('auth-verified', () => {
      loadLogs();
    });

    // Si ya está autenticado (para reload), cargar después de un pequeño delay
    setTimeout(() => {
      const token = localStorage.getItem('token');
      if (token) {
        loadLogs();
      }
    }, 200);
  </script>
</BaseLayout>
