---
/**
 * Página de Aprobación de Períodos de Tiempo del Proyecto
 * Sistema de Gobierno y Seguridad - Fase 2
 * NOTA: Esta página ahora usa el sistema de diseño TimeFlow
 * Los estilos están en: /src/styles/aprobaciones.css
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import ProtectedRoute from '../../../components/ProtectedRoute.astro';
import '../../../styles/aprobaciones.css';

const { id } = Astro.params;
const proyectoId = parseInt(id || '0');

const title = `Aprobaciones - Proyecto ${proyectoId}`;
---

<BaseLayout title={title}>
  <ProtectedRoute />
  <Header />

  <main class="aprobaciones-container">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Aprobación de Hojas de Tiempo</h1>
      <p class="mt-2 text-gray-600">Revisión y aprobación de períodos trabajados</p>
    </div>

    <!-- Mensajes -->
    <div id="message-container"></div>

    <!-- Tabs -->
    <div class="border-b border-gray-200 mb-6">
      <nav class="-mb-px flex space-x-8">
        <button
          data-tab="pending"
          class="tab-button border-b-2 border-indigo-500 py-4 px-1 text-sm font-medium text-indigo-600"
        >
          Pendientes
          <span id="badge-pending" class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
            0
          </span>
        </button>
        <button
          data-tab="approved"
          class="tab-button border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300"
        >
          Aprobados
        </button>
        <button
          data-tab="rejected"
          class="tab-button border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300"
        >
          Rechazados
        </button>
        <button
          data-tab="locked"
          class="tab-button border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300"
        >
          Bloqueados
        </button>
      </nav>
    </div>

    <!-- Loading -->
    <div id="loading-state" class="text-center py-12">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mx-auto"></div>
      <p class="mt-4 text-gray-600">Cargando períodos...</p>
    </div>

    <!-- Lista de períodos -->
    <div id="periods-container" class="hidden space-y-4"></div>

    <!-- Estado vacío -->
    <div id="empty-state" class="hidden text-center py-12 bg-white rounded-lg shadow-sm border border-gray-200">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No hay períodos</h3>
      <p class="mt-1 text-sm text-gray-500">No se encontraron períodos en este estado.</p>
    </div>
  </main>

  <!-- Modal: Aprobar Período -->
  <div id="modal-approve" class="fixed z-10 inset-0 overflow-y-auto hidden" role="dialog">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
      
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <form id="form-approve">
          <div class="bg-white px-4 pt-5 pb-4 sm:p-6">
            <div class="sm:flex sm:items-start">
              <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-green-100 sm:mx-0 sm:h-10 sm:w-10">
                <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left flex-1">
                <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
                  Aprobar Período
                </h3>
                <div class="mt-2">
                  <p class="text-sm text-gray-500 mb-4" id="approve-period-info">
                    <!-- Info del período -->
                  </p>
                  <div>
                    <label for="approve-notes" class="block text-sm font-medium text-gray-700 mb-2">
                      Notas (opcional)
                    </label>
                    <textarea
                      id="approve-notes"
                      rows="3"
                      class="block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                      placeholder="Comentarios adicionales..."
                    ></textarea>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
            <button
              type="submit"
              class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-green-600 text-base font-medium text-white hover:bg-green-700 focus:outline-none sm:ml-3 sm:w-auto sm:text-sm"
            >
              Aprobar
            </button>
            <button
              type="button"
              id="btn-cancel-approve"
              class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:w-auto sm:text-sm"
            >
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: Rechazar Período -->
  <div id="modal-reject" class="fixed z-10 inset-0 overflow-y-auto hidden" role="dialog">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
      
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <form id="form-reject">
          <div class="bg-white px-4 pt-5 pb-4 sm:p-6">
            <div class="sm:flex sm:items-start">
              <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </div>
              <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left flex-1">
                <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
                  Rechazar Período
                </h3>
                <div class="mt-2">
                  <p class="text-sm text-gray-500 mb-4" id="reject-period-info">
                    <!-- Info del período -->
                  </p>
                  <div>
                    <label for="reject-notes" class="block text-sm font-medium text-gray-700 mb-2">
                      Motivo del rechazo * <span class="text-xs text-gray-500">(mínimo 10 caracteres)</span>
                    </label>
                    <textarea
                      id="reject-notes"
                      rows="4"
                      required
                      minlength="10"
                      class="block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                      placeholder="Explica por qué se rechaza este período..."
                    ></textarea>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
            <button
              type="submit"
              class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none sm:ml-3 sm:w-auto sm:text-sm"
            >
              Rechazar
            </button>
            <button
              type="button"
              id="btn-cancel-reject"
              class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:w-auto sm:text-sm"
            >
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: Detalles del Período -->
  <div id="modal-details" class="fixed z-10 inset-0 overflow-y-auto hidden" role="dialog">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
      
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full">
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Detalles del Período</h3>
            <button id="btn-close-details" class="text-gray-400 hover:text-gray-500">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <div id="details-content">
            <!-- Se llenará dinámicamente -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { approvalService } from '../../../services/approvalService';
    import type { TimePeriod } from '../../../types/approval';

    // Obtener proyecto_id de la URL
    const pathParts = window.location.pathname.split('/');
    const proyectoId = parseInt(pathParts[2]);

    let currentTab = 'pending';
    let periods: TimePeriod[] = [];
    let currentPeriodId: number | null = null;

    const statusFilters: Record<string, string[]> = {
      pending: ['pending'],
      approved: ['approved'],
      rejected: ['rejected'],
      locked: ['locked'],
    };

    // Cargar períodos
    async function loadPeriods() {
      const loading = document.getElementById('loading-state');
      const container = document.getElementById('periods-container');
      const empty = document.getElementById('empty-state');

      try {
        // Debug
        const token = localStorage.getItem('token');
        const orgId = localStorage.getItem('currentOrganizationId');
        console.log('Debug - Token presente:', !!token, 'OrgId:', orgId, 'ProyectoId:', proyectoId);
        
        if (loading) loading.classList.remove('hidden');
        if (container) container.classList.add('hidden');
        if (empty) empty.classList.add('hidden');

        if (currentTab === 'pending') {
          periods = await approvalService.getPendingPeriods(proyectoId);
        } else {
          // Obtener todos los períodos del proyecto
          periods = await approvalService.getProjectPeriods(proyectoId);
        }
        
        if (loading) loading.classList.add('hidden');

        // Actualizar badge de pendientes
        const badge = document.getElementById('badge-pending');
        if (badge && currentTab === 'pending') {
          badge.textContent = periods.length.toString();
        }

        if (periods.length === 0) {
          if (empty) empty.classList.remove('hidden');
        } else {
          if (container) {
            container.classList.remove('hidden');
            renderPeriods();
          }
        }
      } catch (error) {
        console.error('Error al cargar períodos:', error);
        showMessage('Error al cargar períodos', 'error');
        if (loading) loading.classList.add('hidden');
      }
    }

    // Renderizar períodos
    function renderPeriods() {
      const container = document.getElementById('periods-container');
      if (!container) return;

      const statusColors: Record<string, string> = {
        draft: 'bg-gray-100 text-gray-800',
        pending: 'bg-yellow-100 text-yellow-800',
        approved: 'bg-green-100 text-green-800',
        rejected: 'bg-red-100 text-red-800',
        locked: 'bg-purple-100 text-purple-800',
      };

      const statusLabels: Record<string, string> = {
        draft: 'Borrador',
        pending: 'Pendiente',
        approved: 'Aprobado',
        rejected: 'Rechazado',
        locked: 'Bloqueado',
      };

      container.innerHTML = periods.map(period => `
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="text-lg font-semibold text-gray-900">${period.proyecto_nombre || 'Proyecto'}</h3>
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${statusColors[period.status]}">
                  ${statusLabels[period.status]}
                </span>
              </div>
              <p class="text-sm text-gray-600">
                ${period.empleado_nombre || 'Personal'} • ${getMonthName(period.mes)} ${period.anio}
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
            <div>
              <div class="text-sm text-gray-500">Período</div>
              <div class="text-sm font-medium text-gray-900">
                ${new Date(period.fecha_inicio).toLocaleDateString('es-ES')} - ${new Date(period.fecha_fin).toLocaleDateString('es-ES')}
              </div>
            </div>
            <div>
              <div class="text-sm text-gray-500">Total Horas</div>
              <div class="text-sm font-medium text-gray-900">${period.total_hours || 0} h</div>
            </div>
            <div>
              <div class="text-sm text-gray-500">Total Días</div>
              <div class="text-sm font-medium text-gray-900">${period.total_days || 0}</div>
            </div>
            <div>
              <div class="text-sm text-gray-500">Enviado</div>
              <div class="text-sm font-medium text-gray-900">
                ${period.submitted_at ? new Date(period.submitted_at).toLocaleDateString('es-ES') : '-'}
              </div>
            </div>
          </div>

          ${period.review_notes ? `
            <div class="mb-4 p-3 bg-gray-50 rounded-md">
              <div class="text-sm font-medium text-gray-700 mb-1">Notas de revisión:</div>
              <div class="text-sm text-gray-600">${period.review_notes}</div>
            </div>
          ` : ''}

          <div class="flex gap-2">
            <button
              onclick="viewPeriodDetails(${period.id})"
              class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
            >
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
              Ver detalles
            </button>
            
            ${period.status === 'pending' ? `
              <button
                onclick="approvePeriod(${period.id}, '${period.empleado_nombre}', '${getMonthName(period.mes)} ${period.anio}')"
                class="inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Aprobar
              </button>
              <button
                onclick="rejectPeriod(${period.id}, '${period.empleado_nombre}', '${getMonthName(period.mes)} ${period.anio}')"
                class="inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                Rechazar
              </button>
            ` : ''}
          </div>
        </div>
      `).join('');
    }

    function getMonthName(month: number): string {
      const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 
                      'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
      return months[month - 1] || '';
    }

    // Cambiar tab
    document.querySelectorAll('.tab-button').forEach(button => {
      button.addEventListener('click', (e) => {
        const tab = (e.target as HTMLElement).dataset.tab;
        if (!tab) return;

        // Actualizar estilos de tabs
        document.querySelectorAll('.tab-button').forEach(btn => {
          btn.classList.remove('border-indigo-500', 'text-indigo-600');
          btn.classList.add('border-transparent', 'text-gray-500');
        });
        (e.target as HTMLElement).classList.remove('border-transparent', 'text-gray-500');
        (e.target as HTMLElement).classList.add('border-indigo-500', 'text-indigo-600');

        currentTab = tab;
        loadPeriods();
      });
    });

    // Ver detalles
    (window as any).viewPeriodDetails = async (periodId: number) => {
      try {
        // Buscar el período en la lista actual
        const period = periods.find(p => p.id === periodId);
        if (!period) {
          showMessage('Período no encontrado', 'error');
          return;
        }
        
        const modal = document.getElementById('modal-details');
        const content = document.getElementById('details-content');
        
        if (!modal || !content) return;

        content.innerHTML = `
          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <div class="text-sm font-medium text-gray-500">Personal</div>
                <div class="text-sm text-gray-900">${period.empleado?.nombre || '-'}</div>
              </div>
              <div>
                <div class="text-sm font-medium text-gray-500">Proyecto</div>
                <div class="text-sm text-gray-900">${period.proyecto?.nombre || '-'}</div>
              </div>
            </div>

            <div>
              <h4 class="text-sm font-medium text-gray-900 mb-2">Días trabajados</h4>
              <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Fecha</th>
                      <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Horas</th>
                      <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Estado</th>
                    </tr>
                  </thead>
                  <tbody class="bg-white divide-y divide-gray-200">
                    ${(period.dias || []).map((dia: any) => `
                      <tr>
                        <td class="px-4 py-2 text-sm text-gray-900">${new Date(dia.fecha).toLocaleDateString('es-ES')}</td>
                        <td class="px-4 py-2 text-sm text-gray-900">${dia.horas_trabajadas || 0} h</td>
                        <td class="px-4 py-2 text-sm">
                          <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${dia.status === 'approved' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
                            ${dia.status}
                          </span>
                        </td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        `;

        modal.classList.remove('hidden');
      } catch (error) {
        showMessage('Error al cargar detalles del período', 'error');
      }
    };

    // Aprobar período
    (window as any).approvePeriod = (periodId: number, empleado: string, periodo: string) => {
      currentPeriodId = periodId;
      const modal = document.getElementById('modal-approve');
      const info = document.getElementById('approve-period-info');
      
      if (info) info.textContent = `¿Aprobar el período de ${empleado} para ${periodo}?`;
      if (modal) modal.classList.remove('hidden');
    };

    document.getElementById('form-approve')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentPeriodId) return;

      const notes = (document.getElementById('approve-notes') as HTMLTextAreaElement)?.value;

      try {
        await approvalService.approvePeriod(currentPeriodId, { notes });
        showMessage('Período aprobado exitosamente', 'success');
        document.getElementById('modal-approve')?.classList.add('hidden');
        (document.getElementById('approve-notes') as HTMLTextAreaElement).value = '';
        await loadPeriods();
      } catch (error: any) {
        showMessage(error.message || 'Error al aprobar período', 'error');
      }
    });

    // Rechazar período
    (window as any).rejectPeriod = (periodId: number, empleado: string, periodo: string) => {
      currentPeriodId = periodId;
      const modal = document.getElementById('modal-reject');
      const info = document.getElementById('reject-period-info');
      
      if (info) info.textContent = `¿Rechazar el período de ${empleado} para ${periodo}?`;
      if (modal) modal.classList.remove('hidden');
    };

    document.getElementById('form-reject')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentPeriodId) return;

      const notes = (document.getElementById('reject-notes') as HTMLTextAreaElement)?.value;

      if (!notes || notes.length < 10) {
        showMessage('El motivo del rechazo debe tener al menos 10 caracteres', 'error');
        return;
      }

      try {
        await approvalService.rejectPeriod(currentPeriodId, { notes });
        showMessage('Período rechazado', 'success');
        document.getElementById('modal-reject')?.classList.add('hidden');
        (document.getElementById('reject-notes') as HTMLTextAreaElement).value = '';
        await loadPeriods();
      } catch (error: any) {
        showMessage(error.message || 'Error al rechazar período', 'error');
      }
    });

    // Cerrar modales
    document.getElementById('btn-cancel-approve')?.addEventListener('click', () => {
      document.getElementById('modal-approve')?.classList.add('hidden');
    });

    document.getElementById('btn-cancel-reject')?.addEventListener('click', () => {
      document.getElementById('modal-reject')?.classList.add('hidden');
    });

    document.getElementById('btn-close-details')?.addEventListener('click', () => {
      document.getElementById('modal-details')?.classList.add('hidden');
    });

    // Mostrar mensaje
    function showMessage(message: string, type: 'success' | 'error') {
      const container = document.getElementById('message-container');
      if (!container) return;

      const bgColor = type === 'success' ? 'bg-green-50 border-green-200 text-green-800' : 'bg-red-50 border-red-200 text-red-800';
      
      container.innerHTML = `
        <div class="${bgColor} border px-4 py-3 rounded-md mb-4">
          <p class="text-sm font-medium">${message}</p>
        </div>
      `;

      setTimeout(() => {
        container.innerHTML = '';
      }, 5000);
    }

    // Esperar a que la autenticación esté verificada
    window.addEventListener('auth-verified', () => {
      loadPeriods();
    });

    // Si ya está autenticado (para reload), cargar después de un pequeño delay
    setTimeout(() => {
      const token = localStorage.getItem('token');
      if (token) {
        loadPeriods();
      }
    }, 200);
  </script>
</BaseLayout>
