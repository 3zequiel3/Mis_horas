---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProtectedRoute from '../components/ProtectedRoute.astro';
import SuperWizard from '../components/SuperWizard.astro';
import '../styles/nuevo-proyecto.css';

const pageTitle = 'Nuevo Tablero';
---

<BaseLayout title={pageTitle}>
  <ProtectedRoute />
  <Header />

  <div class="nuevo-proyecto-container">
    <SuperWizard organizationType="empresa" />
  </div>
</BaseLayout>

<style>
  .nuevo-proyecto-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 200px);
    padding: 2rem;
  }
</style>
