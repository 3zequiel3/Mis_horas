---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProtectedRoute from '../components/ProtectedRoute.astro';
import '../styles/nuevo-proyecto.css';

const pageTitle = 'Nuevo Tablero';
---

<BaseLayout title={pageTitle}>
  <ProtectedRoute>
    <Header />
    <div class="nuevo-proyecto-container">
      <div class="proyecto-card">
        <form id="proyecto-form" class="proyecto-form">
          <!-- PASO 1: Información Básica -->
          <div class="wizard-step active" data-step="1">
            <div class="step-content">
              <div class="step-icon">📋</div>
              <h3>Información del Tablero</h3>
              
              <div class="form-group">
                <label for="nombre">Nombre del Tablero *</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  placeholder="Ej: Proyecto Web 2025"
                  required
                />
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="anio">Año *</label>
                  <select id="anio" name="anio" required>
                    <option value="">Selecciona un año</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="mes">Mes *</label>
                  <select id="mes" name="mes" required>
                    <option value="">Selecciona un mes</option>
                    <option value="1">Enero</option>
                    <option value="2">Febrero</option>
                    <option value="3">Marzo</option>
                    <option value="4">Abril</option>
                    <option value="5">Mayo</option>
                    <option value="6">Junio</option>
                    <option value="7">Julio</option>
                    <option value="8">Agosto</option>
                    <option value="9">Septiembre</option>
                    <option value="10">Octubre</option>
                    <option value="11">Noviembre</option>
                    <option value="12">Diciembre</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="descripcion">Descripción (Opcional)</label>
                <textarea
                  id="descripcion"
                  name="descripcion"
                  placeholder="Describe el propósito del tablero..."
                  rows="3"
                ></textarea>
              </div>

              <div class="form-group">
                <label for="cliente">Cliente (Opcional)</label>
                <input
                  type="text"
                  id="cliente"
                  name="cliente"
                  placeholder="Nombre del cliente o empresa"
                  maxlength="255"
                />
              </div>

              <div class="form-group">
                <label>Color de Marca (Opcional)</label>
                <div class="color-picker-section">
                  <div class="color-presets">
                    <button type="button" class="color-preset" data-color="#3B82F6" style="background: #3B82F6" title="Azul"></button>
                    <button type="button" class="color-preset" data-color="#10B981" style="background: #10B981" title="Verde"></button>
                    <button type="button" class="color-preset" data-color="#F59E0B" style="background: #F59E0B" title="Amarillo"></button>
                    <button type="button" class="color-preset" data-color="#EF4444" style="background: #EF4444" title="Rojo"></button>
                    <button type="button" class="color-preset" data-color="#8B5CF6" style="background: #8B5CF6" title="Púrpura"></button>
                    <button type="button" class="color-preset" data-color="#EC4899" style="background: #EC4899" title="Rosa"></button>
                  </div>
                  <div class="color-custom">
                    <input type="color" id="brand_color_picker" value="#3B82F6" />
                    <input type="text" id="brand_color" name="brand_color" placeholder="#3B82F6" maxlength="7" pattern="^#[0-9A-Fa-f]{6}$" />
                  </div>
                </div>
              </div>
            </div>

            <div class="step-actions">
              <a href="/proyectos" class="btn btn-secondary">Cancelar</a>
              <button type="button" class="btn btn-primary" data-next-step="2">
                Siguiente <span class="btn-icon">→</span>
              </button>
            </div>
          </div>

          <!-- PASO 2: Módulos del Proyecto -->
          <div class="wizard-step" data-step="2">
            <div class="step-content">
              <div class="step-icon">🧩</div>
              <h3>Módulos del Proyecto</h3>
              <p class="step-description">Selecciona las funcionalidades que necesitas</p>
              
              <div class="modules-grid">
                <div class="module-card active" data-module="time_tracking">
                  <div class="module-icon">⏱️</div>
                  <h4>Tracking de Tiempo</h4>
                  <p>Registro de horas trabajadas</p>
                  <div class="module-toggle">✓</div>
                </div>

                <div class="module-card" data-module="budget">
                  <div class="module-icon">💰</div>
                  <h4>Gestión de Presupuesto</h4>
                  <p>Control de costos y burn rate</p>
                  <div class="module-toggle">✓</div>
                </div>

                <div class="module-card" data-module="audit">
                  <div class="module-icon">📋</div>
                  <h4>Auditoría</h4>
                  <p>Timeline de cambios y acciones</p>
                  <div class="module-toggle">✓</div>
                </div>

                <div class="module-card" data-module="public_view">
                  <div class="module-icon">🌐</div>
                  <h4>Vista Pública</h4>
                  <p>Compartir progreso con cliente</p>
                  <div class="module-toggle">✓</div>
                </div>
              </div>

              <input type="hidden" id="modules_config" name="modules_config" />
            </div>

            <div class="step-actions">
              <button type="button" class="btn btn-secondary" data-prev-step="1">
                <span class="btn-icon">←</span> Atrás
              </button>
              <button type="button" class="btn btn-primary" data-next-step="3">
                Siguiente <span class="btn-icon">→</span>
              </button>
            </div>
          </div>

          <!-- PASO 3: Configuración Financiera (Condicional) -->
          <div class="wizard-step" data-step="3" id="step-financiero" style="display: none;">
            <div class="step-content">
              <div class="step-icon">💰</div>
              <h3>Configuración de Presupuesto</h3>
              <p class="step-description">Define el tipo de presupuesto para este proyecto</p>
              
              <div class="budget-types-grid">
                <div class="budget-type-card" data-budget-type="fixed_price">
                  <div class="budget-type-icon">💵</div>
                  <h4>Monto Fijo</h4>
                  <p>Precio total acordado</p>
                  <div class="budget-type-check">✓</div>
                </div>

                <div class="budget-type-card" data-budget-type="hourly_retainer">
                  <div class="budget-type-icon">⏰</div>
                  <h4>Bolsa de Horas</h4>
                  <p>Cantidad de horas prepagadas</p>
                  <div class="budget-type-check">✓</div>
                </div>

                <div class="budget-type-card" data-budget-type="time_and_materials">
                  <div class="budget-type-icon">📊</div>
                  <h4>Por Hora (T&M)</h4>
                  <p>Cobro según horas trabajadas</p>
                  <div class="budget-type-check">✓</div>
                </div>
              </div>

              <div id="budget-amount-section" style="display: none; margin-top: 1.5rem;">
                <div class="form-row">
                  <div class="form-group">
                    <label for="currency">Moneda</label>
                    <select id="currency" name="currency">
                      <option value="USD">💵 USD - Dólar</option>
                      <option value="EUR">💶 EUR - Euro</option>
                      <option value="ARS">🇦🇷 ARS - Peso Argentino</option>
                      <option value="MXN">🇲🇽 MXN - Peso Mexicano</option>
                      <option value="CLP">🇨🇱 CLP - Peso Chileno</option>
                      <option value="COP">🇨🇴 COP - Peso Colombiano</option>
                      <option value="BRL">🇧🇷 BRL - Real Brasileño</option>
                    </select>
                  </div>

                  <div class="form-group">
                    <label for="budget_base_amount" id="budget-amount-label">Monto</label>
                    <input
                      type="number"
                      id="budget_base_amount"
                      name="budget_base_amount"
                      placeholder="0.00"
                      min="0"
                      step="0.01"
                    />
                  </div>
                </div>
              </div>

              <input type="hidden" id="budget_type" name="budget_type" value="none" />
            </div>

            <div class="step-actions">
              <button type="button" class="btn btn-secondary" data-prev-step="2">
                <span class="btn-icon">←</span> Atrás
              </button>
              <button type="button" class="btn btn-primary" id="btn-next-from-budget">
                Siguiente <span class="btn-icon">→</span>
              </button>
            </div>
          </div>

          <!-- PASO 4: Tipo de Tablero -->
          <div class="wizard-step" data-step="4">
            <div class="step-content">
              <div class="step-icon">🎯</div>
              <h3>¿Cómo gestionarás este tablero?</h3>
              
              <div class="tipo-tablero-grid">
                <div class="tipo-card" data-tipo="personal">
                  <div class="tipo-icon">💼</div>
                  <h4>Personal</h4>
                  <p>Solo tu trabajo personal</p>
                  <div class="tipo-check">✓</div>
                </div>

                <div class="tipo-card" data-tipo="empleados">
                  <div class="tipo-icon">👥</div>
                  <h4>Con Equipo</h4>
                  <p>Gestiona tu equipo de trabajo</p>
                  <div class="tipo-check">✓</div>
                </div>
              </div>

              <input type="hidden" id="tipo_proyecto" name="tipo_proyecto" required />
            </div>

            <div class="step-actions">
              <button type="button" class="btn btn-secondary" id="btn-back-from-tipo">
                <span class="btn-icon">←</span> Atrás
              </button>
            </div>
          </div>

          <!-- PASO 5: Empleados -->
          <div class="wizard-step" data-step="5">
            <div class="step-content">
              <div class="step-icon">👥</div>
              <h3>Gestión del Equipo</h3>

              <div id="empleados-list" class="empleados-list">
                <div class="empleado-item">
                  <div class="form-group">
                    <label>Nombre del Integrante</label>
                    <input type="text" class="empleado-nombre" placeholder="Juan Pérez" maxlength="100" />
                  </div>
                  <div class="form-group">
                    <label>Usuario (Opcional) <span class="link-icon">🔗</span></label>
                    <input type="email" class="empleado-email" placeholder="usuario@mail.com" />
                  </div>
                  <button type="button" class="btn-remove-empleado" title="Eliminar empleado">✕</button>
                </div>
              </div>

              <button type="button" id="add-empleado-btn" class="btn btn-add-item">
                <span>+</span> Agregar Integrante
              </button>
            </div>

            <div class="step-actions">
              <button type="button" class="btn btn-secondary" data-prev-step="4">
                <span class="btn-icon">←</span> Atrás
              <button type="submit" class="btn btn-primary btn-lg">
                <span class="btn-icon">✓</span> Crear Tablero
              </button>
            </div>
          </div>
        </form>

        <div id="success-message" class="alert alert-success" style="display: none;">
          ✓ Tablero creado exitosamente
        </div>

        <div id="error-message" class="alert alert-error" style="display: none;">
          ✗ Error al crear el tablero
        </div>
      </div>
    </div>

<script>
  import { AuthService } from '../services/auth';
  import { ProyectoFormHandler } from '../handlers/nuevo-proyecto';

  // Verificar autenticación
  if (!AuthService.isAuthenticated()) {
    window.location.href = '/login';
  }

  // FASE 1 MULTI-TENANT: Inicializar contexto organizacional
  await ProyectoFormHandler.inicializar();

  // Estado del wizard
  let currentStep = 1;
  let tipoSeleccionado: 'personal' | 'empleados' | null = null;

  // Inicializar select de años y meses
  ProyectoFormHandler.inicializarAnios();
  ProyectoFormHandler.inicializarMes();

  // Funciones de navegación
  function showStep(stepNumber: number | string) {
    const steps = document.querySelectorAll('.wizard-step');
    steps.forEach(step => {
      const stepEl = step as HTMLElement;
      const stepValue = stepEl.dataset.step || '';
      if (stepValue === stepNumber.toString()) {
        stepEl.classList.add('active');
      } else {
        stepEl.classList.remove('active');
      }
    });
    if (typeof stepNumber === 'number') {
      currentStep = stepNumber;
    }
  }

  function validateStep1(): boolean {
    const nombre = (document.getElementById('nombre') as HTMLInputElement).value;
    const anio = (document.getElementById('anio') as HTMLSelectElement).value;
    const mes = (document.getElementById('mes') as HTMLSelectElement).value;
    
    if (!nombre.trim()) {
      alert('Por favor ingresa el nombre del tablero');
      return false;
    }
    if (!anio) {
      alert('Por favor selecciona un año');
      return false;
    }
    if (!mes) {
      alert('Por favor selecciona un mes');
      return false;
    }
    return true;
  }

  // Botones de navegación
  document.querySelectorAll('[data-next-step]').forEach(btn => {
    btn.addEventListener('click', () => {
      const nextStep = parseInt((btn as HTMLElement).dataset.nextStep || '0');
      
      if (currentStep === 1 && !validateStep1()) {
        return;
      }
      
      showStep(nextStep);
    });
  });

  document.querySelectorAll('[data-prev-step]').forEach(btn => {
    btn.addEventListener('click', () => {
      const prevStep = parseInt((btn as HTMLElement).dataset.prevStep || '0');
      showStep(prevStep);
    });
  });

  // Gestión del color picker
  const colorPresets = document.querySelectorAll('.color-preset');
  const colorPicker = document.getElementById('brand_color_picker') as HTMLInputElement;
  const colorInput = document.getElementById('brand_color') as HTMLInputElement;

  colorPresets.forEach(preset => {
    preset.addEventListener('click', () => {
      const color = (preset as HTMLElement).dataset.color || '#3B82F6';
      colorPresets.forEach(p => p.classList.remove('selected'));
      preset.classList.add('selected');
      colorPicker.value = color;
      colorInput.value = color;
    });
  });

  colorPicker?.addEventListener('input', (e) => {
    const color = (e.target as HTMLInputElement).value;
    colorInput.value = color.toUpperCase();
    colorPresets.forEach(p => p.classList.remove('selected'));
  });

  colorInput?.addEventListener('input', (e) => {
    const color = (e.target as HTMLInputElement).value;
    if (/^#[0-9A-Fa-f]{6}$/.test(color)) {
      colorPicker.value = color;
      colorPresets.forEach(p => p.classList.remove('selected'));
    }
  });

  // Gestión de módulos
  const moduleCards = document.querySelectorAll('.module-card');
  const modulesInput = document.getElementById('modules_config') as HTMLInputElement;
  const stepFinanciero = document.getElementById('step-financiero') as HTMLElement;
  
  // Estado inicial de módulos (time_tracking activo por defecto)
  const modulesState = {
    time_tracking: true,
    budget: false,
    audit: false,
    public_view: false
  };

  // Actualizar input hidden con estado de módulos
  function updateModulesConfig() {
    modulesInput.value = JSON.stringify(modulesState);
    
    // Mostrar/ocultar paso financiero según módulo budget
    if (modulesState.budget) {
      stepFinanciero.style.display = '';
    } else {
      stepFinanciero.style.display = 'none';
    }
  }
  
  updateModulesConfig();

  moduleCards.forEach(card => {
    card.addEventListener('click', () => {
      const module = (card as HTMLElement).dataset.module as keyof typeof modulesState;
      
      // Toggle estado
      modulesState[module] = !modulesState[module];
      
      // Actualizar UI
      if (modulesState[module]) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }
      
      updateModulesConfig();
    });
  });

  // Botón siguiente desde módulos: ir a paso 3 (financiero) o 4 (tipo tablero)
  document.querySelector('[data-next-step="3"]')?.addEventListener('click', () => {
    if (modulesState.budget) {
      showStep(3); // Ir a configuración financiera
    } else {
      showStep(4); // Saltar directo a tipo de tablero
    }
  });

  // Gestión del paso financiero
  const budgetTypeCards = document.querySelectorAll('.budget-type-card');
  const budgetTypeInput = document.getElementById('budget_type') as HTMLInputElement;
  const budgetAmountSection = document.getElementById('budget-amount-section') as HTMLElement;
  const budgetAmountLabel = document.getElementById('budget-amount-label') as HTMLElement;
  let budgetTypeSelected: string = 'none';

  budgetTypeCards.forEach(card => {
    card.addEventListener('click', () => {
      const type = (card as HTMLElement).dataset.budgetType || 'none';
      budgetTypeSelected = type;
      budgetTypeInput.value = type;
      
      // Actualizar UI
      budgetTypeCards.forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      
      // Mostrar sección de monto
      if (type === 'fixed_price') {
        budgetAmountLabel.textContent = 'Monto Total';
        budgetAmountSection.style.display = 'block';
      } else if (type === 'hourly_retainer') {
        budgetAmountLabel.textContent = 'Cantidad de Horas';
        budgetAmountSection.style.display = 'block';
      } else {
        // time_and_materials no requiere monto inicial
        budgetAmountSection.style.display = 'none';
      }
    });
  });

  // Botón siguiente desde financiero
  document.getElementById('btn-next-from-budget')?.addEventListener('click', () => {
    showStep(4); // Ir a tipo de tablero
  });

  // Botón atrás desde tipo de tablero
  document.getElementById('btn-back-from-tipo')?.addEventListener('click', () => {
    if (modulesState.budget) {
      showStep(3); // Volver a financiero si budget activo
    } else {
      showStep(2); // Volver a módulos
    }
  });

  // Selección de tipo de tablero
  const tipoCards = document.querySelectorAll('.tipo-card');
  const tipoInput = document.getElementById('tipo_proyecto') as HTMLInputElement;

  tipoCards.forEach(card => {
    card.addEventListener('click', () => {
      const tipo = (card as HTMLElement).dataset.tipo as 'personal' | 'empleados';
      tipoSeleccionado = tipo;
      tipoInput.value = tipo;
      
      // Actualizar UI
      tipoCards.forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      
      // Navegar según tipo
      if (tipo === 'personal') {
        // Si es personal, crear directamente
        setTimeout(async () => {
          await ProyectoFormHandler.crearProyecto();
        }, 300);
      } else {
        // Si es con empleados, ir a paso 5
        setTimeout(() => showStep(5), 300);
      }
    });
  });

  // Gestión de empleados
  const addEmpleadoBtn = document.getElementById('add-empleado-btn') as HTMLButtonElement;
  const empleadosList = document.getElementById('empleados-list') as HTMLElement;

  function setupEmpleadoRemove(item: Element) {
    const removeBtn = item.querySelector('.btn-remove-empleado');
    removeBtn?.addEventListener('click', () => {
      if (empleadosList.querySelectorAll('.empleado-item').length > 1) {
        item.remove();
      } else {
        alert('Debe haber al menos un empleado');
      }
    });
  }

  // Setup inicial del primer empleado
  setupEmpleadoRemove(empleadosList.querySelector('.empleado-item')!);

  addEmpleadoBtn?.addEventListener('click', () => {
    const empleadoItem = document.createElement('div');
    empleadoItem.className = 'empleado-item';
    empleadoItem.innerHTML = `
      <div class="form-group">
        <label>Nombre del Empleado</label>
        <input type="text" class="empleado-nombre" placeholder="Juan Pérez" maxlength="100" />
      </div>
      <div class="form-group">
        <label>Usuario (Opcional) <span class="link-icon">🔗</span></label>
        <input type="email" class="empleado-email" placeholder="usuario@mail.com" />
      </div>
      <button type="button" class="btn-remove-empleado" title="Eliminar empleado">✕</button>
    `;
    empleadosList.appendChild(empleadoItem);
    setupEmpleadoRemove(empleadoItem);
  });

  // Manejo del formulario
  const form = document.getElementById('proyecto-form') as HTMLFormElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    await ProyectoFormHandler.crearProyecto();
  });
</script>
  </ProtectedRoute>
</BaseLayout>
