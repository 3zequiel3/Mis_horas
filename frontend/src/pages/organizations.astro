---
/**
 * Página de Gestión de Organizaciones
 * Sistema Multi-Tenant - Fase 1
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProtectedRoute from '../components/ProtectedRoute.astro';

const title = 'Gestión de Organizaciones';
---

<BaseLayout title={title}>
  <ProtectedRoute />
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Encabezado -->
    <div class="mb-8">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Mis Organizaciones</h1>
          <p class="mt-2 text-gray-600">Gestiona tus espacios de trabajo y equipos</p>
        </div>
        <button
          id="btn-new-org"
          class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          Nueva Organización
        </button>
      </div>
    </div>

    <!-- Mensajes -->
    <div id="message-container"></div>

    <!-- Loading state -->
    <div id="loading-state" class="text-center py-12">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mx-auto"></div>
      <p class="mt-4 text-gray-600">Cargando organizaciones...</p>
    </div>

    <!-- Lista de organizaciones -->
    <div id="organizations-grid" class="hidden grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <!-- Se llenará dinámicamente -->
    </div>

    <!-- Estado vacío -->
    <div id="empty-state" class="hidden text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No hay organizaciones</h3>
      <p class="mt-1 text-sm text-gray-500">Comienza creando tu primera organización.</p>
      <div class="mt-6">
        <button
          onclick="document.getElementById('btn-new-org').click()"
          class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          Nueva Organización
        </button>
      </div>
    </div>
  </main>

  <!-- Modal: Nueva/Editar Organización -->
  <div id="modal-org" class="fixed z-10 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
      
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <form id="form-org">
          <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4" id="modal-title">
              Nueva Organización
            </h3>
            
            <div class="space-y-4">
              <div>
                <label for="org-nombre" class="block text-sm font-medium text-gray-700">Nombre *</label>
                <input
                  type="text"
                  id="org-nombre"
                  name="nombre"
                  required
                  class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                  placeholder="Mi Empresa"
                >
              </div>

              <div>
                <label for="org-tipo" class="block text-sm font-medium text-gray-700">Tipo de Organización *</label>
                <select
                  id="org-tipo"
                  name="tipo_organizacion"
                  required
                  class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                >
                  <option value="empresa">Empresa</option>
                  <option value="freelance">Freelance</option>
                  <option value="personal">Personal</option>
                </select>
                <p class="mt-1 text-xs text-gray-500">
                  Personal/Freelance: auto-aprobación, sin jerarquías complejas
                </p>
              </div>

              <div>
                <label for="org-descripcion" class="block text-sm font-medium text-gray-700">Descripción</label>
                <textarea
                  id="org-descripcion"
                  name="descripcion"
                  rows="3"
                  class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                  placeholder="Breve descripción de la organización"
                ></textarea>
              </div>
            </div>
          </div>

          <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
            <button
              type="submit"
              class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-indigo-600 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:ml-3 sm:w-auto sm:text-sm"
            >
              Guardar
            </button>
            <button
              type="button"
              id="btn-cancel-org"
              class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm"
            >
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: Gestionar Miembros -->
  <div id="modal-members" class="fixed z-10 inset-0 overflow-y-auto hidden" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
      
      <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full">
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg leading-6 font-medium text-gray-900">
              Gestionar Miembros
            </h3>
            <button id="btn-close-members" class="text-gray-400 hover:text-gray-500">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Invitar miembro -->
          <div class="mb-6 p-4 bg-gray-50 rounded-lg">
            <h4 class="text-sm font-medium text-gray-900 mb-3">Invitar Nuevo Miembro</h4>
            <form id="form-invite" class="flex gap-2">
              <input
                type="email"
                id="invite-email"
                placeholder="correo@ejemplo.com"
                required
                class="flex-1 border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
              >
              <select
                id="invite-role"
                required
                class="border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
              >
                <option value="admin">Admin</option>
                <option value="manager">Manager</option>
                <option value="member">Miembro</option>
                <option value="viewer">Observador</option>
              </select>
              <button
                type="submit"
                class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700"
              >
                Invitar
              </button>
            </form>
          </div>

          <!-- Lista de miembros -->
          <div>
            <h4 class="text-sm font-medium text-gray-900 mb-3">Miembros Actuales</h4>
            <div id="members-list" class="space-y-2">
              <!-- Se llenará dinámicamente -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { organizationService } from '../services/organizationService';
    import type { Organization } from '../types/organization';
    import { getRoleLabel, getRoleColor, canManageOrganization, canInviteMembers, canRemoveMembers, canChangeMemberRoles } from '../utils/permissions';

    let organizations: Organization[] = [];
    let editingOrgId: number | null = null;
    let currentMembersOrgId: number | null = null;

    // Cargar organizaciones al inicio
    async function loadOrganizations() {
      const loading = document.getElementById('loading-state');
      const grid = document.getElementById('organizations-grid');
      const empty = document.getElementById('empty-state');

      try {
        organizations = await organizationService.getAll();
        
        if (loading) loading.classList.add('hidden');

        if (organizations.length === 0) {
          if (empty) empty.classList.remove('hidden');
          if (grid) grid.classList.add('hidden');
        } else {
          if (empty) empty.classList.add('hidden');
          if (grid) grid.classList.remove('hidden');
          renderOrganizations();
        }
      } catch (error) {
        console.error('Error al cargar organizaciones:', error);
        showMessage('Error al cargar organizaciones', 'error');
        if (loading) loading.classList.add('hidden');
      }
    }

    // Renderizar lista de organizaciones
    function renderOrganizations() {
      const grid = document.getElementById('organizations-grid');
      if (!grid) return;

      const userStr = localStorage.getItem('user');
      const currentUser = userStr ? JSON.parse(userStr) : null;
      const currentUserId = currentUser?.id;

      grid.innerHTML = organizations.map(org => {
        const isOwner = org.owner_id === currentUserId;
        const canManage = isOwner; // Solo el owner puede editar/eliminar

        return `
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-900">${org.nombre}</h3>
                <span class="inline-block mt-1 px-2 py-1 text-xs font-medium rounded-full bg-indigo-100 text-indigo-800 capitalize">
                  ${org.tipo_organizacion}
                </span>
              </div>
              ${isOwner ? `
                <span class="px-2 py-1 text-xs font-medium rounded-full bg-purple-100 text-purple-800">
                  Propietario
                </span>
              ` : ''}
            </div>

            ${org.descripcion ? `
              <p class="text-sm text-gray-600 mb-4">${org.descripcion}</p>
            ` : ''}

            <div class="flex gap-2 mt-4">
              <button
                onclick="selectOrganization(${org.id})"
                class="flex-1 px-3 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700"
              >
                Usar
              </button>
              <button
                onclick="openMembersModal(${org.id})"
                class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                title="Gestionar miembros"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
              </button>
              ${canManage ? `
                <button
                  onclick="editOrganization(${org.id})"
                  class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                  title="Editar"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                </button>
                <button
                  onclick="deleteOrganization(${org.id}, '${org.nombre}')"
                  class="px-3 py-2 text-sm font-medium text-red-700 bg-white border border-red-300 rounded-md hover:bg-red-50"
                  title="Eliminar"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    // Seleccionar organización
    (window as any).selectOrganization = (orgId: number) => {
      organizationService.setCurrentOrganization(orgId);
      showMessage('Organización seleccionada', 'success');
      setTimeout(() => {
        window.location.href = '/dashboard';
      }, 1000);
    };

    // Abrir modal nueva organización
    document.getElementById('btn-new-org')?.addEventListener('click', () => {
      editingOrgId = null;
      const modal = document.getElementById('modal-org');
      const form = document.getElementById('form-org') as HTMLFormElement;
      const title = document.getElementById('modal-title');
      
      if (form) form.reset();
      if (title) title.textContent = 'Nueva Organización';
      if (modal) modal.classList.remove('hidden');
    });

    // Editar organización
    (window as any).editOrganization = (orgId: number) => {
      const org = organizations.find(o => o.id === orgId);
      if (!org) return;

      editingOrgId = orgId;
      const modal = document.getElementById('modal-org');
      const title = document.getElementById('modal-title');
      const nombreInput = document.getElementById('org-nombre') as HTMLInputElement;
      const tipoSelect = document.getElementById('org-tipo') as HTMLSelectElement;
      const descripcionTextarea = document.getElementById('org-descripcion') as HTMLTextAreaElement;

      if (nombreInput) nombreInput.value = org.nombre;
      if (tipoSelect) tipoSelect.value = org.tipo_organizacion;
      if (descripcionTextarea) descripcionTextarea.value = org.descripcion || '';
      if (title) title.textContent = 'Editar Organización';
      if (modal) modal.classList.remove('hidden');
    };

    // Eliminar organización
    (window as any).deleteOrganization = async (orgId: number, orgName: string) => {
      if (!confirm(`¿Estás seguro de que deseas eliminar "${orgName}"? Esta acción no se puede deshacer.`)) {
        return;
      }

      try {
        await organizationService.delete(orgId);
        showMessage('Organización eliminada exitosamente', 'success');
        await loadOrganizations();
      } catch (error: any) {
        showMessage(error.message || 'Error al eliminar organización', 'error');
      }
    };

    // Cerrar modales
    document.getElementById('btn-cancel-org')?.addEventListener('click', () => {
      document.getElementById('modal-org')?.classList.add('hidden');
    });

    document.getElementById('btn-close-members')?.addEventListener('click', () => {
      document.getElementById('modal-members')?.classList.add('hidden');
    });

    // Guardar organización
    document.getElementById('form-org')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      
      const data = {
        nombre: formData.get('nombre') as string,
        tipo_organizacion: formData.get('tipo_organizacion') as any,
        descripcion: formData.get('descripcion') as string || undefined,
      };

      try {
        if (editingOrgId) {
          await organizationService.update(editingOrgId, data);
          showMessage('Organización actualizada exitosamente', 'success');
        } else {
          await organizationService.create(data);
          showMessage('Organización creada exitosamente', 'success');
        }
        
        document.getElementById('modal-org')?.classList.add('hidden');
        await loadOrganizations();
      } catch (error: any) {
        showMessage(error.message || 'Error al guardar organización', 'error');
      }
    });

    // Gestionar miembros
    (window as any).openMembersModal = async (orgId: number) => {
      currentMembersOrgId = orgId;
      const modal = document.getElementById('modal-members');
      if (modal) modal.classList.remove('hidden');
      await loadMembers(orgId);
    };

    async function loadMembers(orgId: number) {
      const membersList = document.getElementById('members-list');
      if (!membersList) return;

      try {
        const members = await organizationService.getMembers(orgId);
        
        membersList.innerHTML = members.map(member => `
          <div class="flex items-center justify-between p-3 bg-gray-50 rounded-md">
            <div class="flex-1">
              <div class="font-medium text-gray-900">${member.user?.nombre || 'Usuario'}</div>
              <div class="text-sm text-gray-500">${member.user?.email || ''}</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 text-xs font-medium rounded-full ${getRoleColor(member.role)}">
                ${getRoleLabel(member.role)}
              </span>
              ${member.role !== 'owner' ? `
                <button
                  onclick="removeMember(${orgId}, ${member.user_id}, '${member.user?.nombre}')"
                  class="text-red-600 hover:text-red-800"
                  title="Eliminar miembro"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </button>
              ` : ''}
            </div>
          </div>
        `).join('');
      } catch (error) {
        console.error('Error al cargar miembros:', error);
        membersList.innerHTML = '<p class="text-sm text-red-600">Error al cargar miembros</p>';
      }
    }

    // Invitar miembro
    document.getElementById('form-invite')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentMembersOrgId) return;

      const emailInput = document.getElementById('invite-email') as HTMLInputElement;
      const roleSelect = document.getElementById('invite-role') as HTMLSelectElement;

      try {
        await organizationService.inviteMember(currentMembersOrgId, {
          email: emailInput.value,
          role: roleSelect.value as any,
        });
        showMessage('Invitación enviada exitosamente', 'success');
        emailInput.value = '';
        await loadMembers(currentMembersOrgId);
      } catch (error: any) {
        showMessage(error.message || 'Error al enviar invitación', 'error');
      }
    });

    // Eliminar miembro
    (window as any).removeMember = async (orgId: number, userId: number, userName: string) => {
      if (!confirm(`¿Estás seguro de que deseas eliminar a ${userName} de esta organización?`)) {
        return;
      }

      try {
        await organizationService.removeMember(orgId, userId);
        showMessage('Miembro eliminado exitosamente', 'success');
        await loadMembers(orgId);
      } catch (error: any) {
        showMessage(error.message || 'Error al eliminar miembro', 'error');
      }
    };

    // Mostrar mensaje
    function showMessage(message: string, type: 'success' | 'error') {
      const container = document.getElementById('message-container');
      if (!container) return;

      const bgColor = type === 'success' ? 'bg-green-50 border-green-200 text-green-800' : 'bg-red-50 border-red-200 text-red-800';
      
      container.innerHTML = `
        <div class="${bgColor} border px-4 py-3 rounded-md mb-4">
          <p class="text-sm font-medium">${message}</p>
        </div>
      `;

      setTimeout(() => {
        container.innerHTML = '';
      }, 5000);
    }

    // Inicializar
    loadOrganizations();
  </script>
</BaseLayout>
