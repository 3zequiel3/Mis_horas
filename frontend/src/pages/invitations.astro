---
/**
 * Página de Invitaciones a Organizaciones
 * Sistema Multi-Tenant - Fase 1
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProtectedRoute from '../components/ProtectedRoute.astro';

const title = 'Invitaciones';
---

<BaseLayout title={title}>
  <ProtectedRoute />
  <Header />

  <main class="invitations-page" role="main" aria-label="Invitaciones pendientes">
    <div class="invitations-header">
      <h1>Invitaciones Pendientes</h1>
      <p>Revisa y responde las invitaciones a organizaciones</p>
    </div>

    <div id="message-container"></div>
    
    <div id="loading-state" class="invitations-loading">
      <div class="loading-spinner"></div>
      <p>Cargando invitaciones...</p>
    </div>

    <div id="invitations-container" class="invitations-list" style="display: none;"></div>

    <div id="empty-state" class="invitations-empty" style="display: none;">
      <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path>
      </svg>
      <h3>No hay invitaciones</h3>
      <p>No tienes invitaciones pendientes en este momento.</p>
    </div>
  </main>

  <style>
    .invitations-page {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    .invitations-header {
      margin-bottom: 2rem;
    }

    .invitations-header h1 {
      font-size: 1.875rem;
      font-weight: 700;
      color: var(--tf-text-primary);
      margin: 0 0 0.5rem 0;
    }

    .invitations-header p {
      color: var(--tf-text-secondary);
      margin: 0;
    }

    .invitations-loading {
      text-align: center;
      padding: 3rem 0;
    }

    .loading-spinner {
      width: 3rem;
      height: 3rem;
      border: 2px solid transparent;
      border-bottom-color: var(--tf-color-primary);
      border-radius: 50%;
      margin: 0 auto;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .invitations-loading p {
      margin-top: 1rem;
      color: var(--tf-text-secondary);
    }

    .invitations-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .invitations-empty {
      text-align: center;
      padding: 3rem 0;
    }

    .empty-icon {
      width: 3rem;
      height: 3rem;
      color: var(--tf-text-muted);
      margin: 0 auto 0.5rem;
      display: block;
    }

    .invitations-empty h3 {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--tf-text-primary);
      margin: 0.5rem 0;
    }

    .invitations-empty p {
      font-size: 0.875rem;
      color: var(--tf-text-muted);
      margin: 0;
    }

    /* Invitation card */
    .invitation-card {
      background: var(--tf-bg-surface);
      border: 1px solid var(--tf-border);
      border-radius: var(--tf-radius-lg);
      padding: 1.5rem;
      box-shadow: var(--tf-shadow-sm);
    }

    .invitation-card-body {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }

    .invitation-card h3 {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--tf-text-primary);
      margin: 0 0 0.25rem;
    }

    .invitation-card .invitation-role {
      font-size: 0.875rem;
      color: var(--tf-text-secondary);
    }

    .invitation-card .invitation-role .role-badge {
      font-weight: 500;
      padding: 0.125rem 0.5rem;
      border-radius: var(--tf-radius-sm);
      background: var(--tf-bg-input);
      color: var(--tf-color-primary);
    }

    .invitation-card .invitation-inviter {
      font-size: 0.875rem;
      color: var(--tf-text-muted);
      margin-top: 0.5rem;
    }

    .invitation-card .invitation-inviter .inviter-name {
      font-weight: 500;
      color: var(--tf-text-secondary);
    }

    .invitation-card .invitation-expiry {
      font-size: 0.75rem;
      color: var(--tf-text-muted);
      margin-top: 0.25rem;
    }

    .invitation-actions {
      margin-top: 1rem;
      display: flex;
      gap: 0.75rem;
    }

    .btn-accept {
      display: inline-flex;
      align-items: center;
      padding: 0.5rem 1rem;
      border: none;
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: var(--tf-radius-md);
      color: white;
      background: var(--tf-color-success);
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .btn-accept:hover {
      opacity: 0.9;
    }

    .btn-accept svg {
      width: 1.25rem;
      height: 1.25rem;
      margin-right: 0.5rem;
    }

    .btn-reject {
      display: inline-flex;
      align-items: center;
      padding: 0.5rem 1rem;
      border: 1px solid var(--tf-border);
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: var(--tf-radius-md);
      color: var(--tf-text-secondary);
      background: transparent;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .btn-reject:hover {
      background: var(--tf-bg-input);
      border-color: var(--tf-border-hover);
    }

    .btn-reject svg {
      width: 1.25rem;
      height: 1.25rem;
      margin-right: 0.5rem;
    }

    /* Message toast */
    .message-toast {
      padding: 0.75rem 1rem;
      border-radius: var(--tf-radius-md);
      margin-bottom: 1rem;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .message-toast.success {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: var(--tf-color-success);
    }

    .message-toast.error {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: var(--tf-color-danger);
    }
  </style>

  <script>
    import { organizationService } from '../services/organizationService';
    import { getRoleLabel } from '../utils/permissions';

    async function loadInvitations() {
      const loading = document.getElementById('loading-state');
      const container = document.getElementById('invitations-container');
      const empty = document.getElementById('empty-state');

      try {
        const invitations = await organizationService.getMyInvitations();
        
        if (loading) loading.style.display = 'none';

        if (invitations.length === 0) {
          if (empty) empty.style.display = 'block';
          if (container) container.style.display = 'none';
        } else {
          if (empty) empty.style.display = 'none';
          if (container) {
            container.style.display = 'flex';
            container.innerHTML = invitations.map(inv => `
              <div class="invitation-card">
                <div class="invitation-card-body">
                  <div>
                    <h3>${inv.organization?.nombre || 'Organización'}</h3>
                    <p class="invitation-role">
                      Te han invitado como <span class="role-badge">${getRoleLabel(inv.role)}</span>
                    </p>
                    ${inv.inviter ? `
                      <p class="invitation-inviter">
                        Invitado por: <span class="inviter-name">${inv.inviter.nombre}</span> (${inv.inviter.email})
                      </p>
                    ` : ''}
                    <p class="invitation-expiry">
                      Expira: ${new Date(inv.expires_at).toLocaleDateString('es-ES')}
                    </p>
                  </div>
                </div>
                
                <div class="invitation-actions">
                  <button
                    onclick="acceptInvitation(${inv.id})"
                    class="btn-accept"
                    aria-label="Aceptar invitación de ${inv.organization?.nombre || 'Organización'}"
                  >
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Aceptar
                  </button>
                  <button
                    onclick="rejectInvitation(${inv.id})"
                    class="btn-reject"
                    aria-label="Rechazar invitación de ${inv.organization?.nombre || 'Organización'}"
                  >
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    Rechazar
                  </button>
                </div>
              </div>
            `).join('');
          }
        }
      } catch (error) {
        console.error('Error al cargar invitaciones:', error);
        showMessage('Error al cargar invitaciones', 'error');
        if (loading) loading.classList.add('hidden');
      }
    }

    (window as any).acceptInvitation = async (invitationId: number) => {
      try {
        await organizationService.acceptInvitation(invitationId);
        showMessage('Invitación aceptada exitosamente', 'success');
        await loadInvitations();
      } catch (error: any) {
        showMessage(error.message || 'Error al aceptar invitación', 'error');
      }
    };

    (window as any).rejectInvitation = async (invitationId: number) => {
      if (!confirm('¿Estás seguro de que deseas rechazar esta invitación?')) return;

      try {
        await organizationService.rejectInvitation(invitationId);
        showMessage('Invitación rechazada', 'success');
        await loadInvitations();
      } catch (error: any) {
        showMessage(error.message || 'Error al rechazar invitación', 'error');
      }
    };

    function showMessage(message: string, type: 'success' | 'error') {
      const container = document.getElementById('message-container');
      if (!container) return;

      const bgClass = type === 'success' ? 'success' : 'error';
      
      container.innerHTML = `
        <div class="message-toast ${bgClass}">
          <p>${message}</p>
        </div>
      `;

      setTimeout(() => {
        container.innerHTML = '';
      }, 5000);
    }

    loadInvitations();
  </script>
</BaseLayout>
