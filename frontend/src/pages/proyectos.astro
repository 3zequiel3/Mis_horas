---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProtectedRoute from '../components/ProtectedRoute.astro';
import '../styles/proyectos.css';

const pageTitle = 'Proyectos';
---

<BaseLayout title={pageTitle}>
  <ProtectedRoute>
    <Header />
    <main class="container" role="main" aria-label="Gestión de proyectos">
    <div class="proyectos-view">
      <div class="view-header">
        <div>
          <h1>Gestión de Proyectos</h1>
          <p>Administra y visualiza todos tus proyectos empresariales</p>
        </div>
        <a href="/nuevo-proyecto" class="btn btn-primary btn-lg">
          + Nuevo Tablero
        </a>
      </div>

      <!-- Tabs de vista -->
      <nav class="view-tabs" role="tablist" aria-label="Vistas de proyectos">
        <button class="tab-btn active" data-tab="table" role="tab" aria-selected="true" aria-controls="table-view">📊 Tabla</button>
        <button class="tab-btn" data-tab="cards" role="tab" aria-selected="false" aria-controls="cards-view">📋 Tarjetas</button>
      </nav>

      <!-- Vista Tabla -->
      <div class="tab-content active" id="table-view" role="tabpanel" aria-labelledby="table">
        <div class="table-container">
          <table class="proyectos-table">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Período</th>
                <th>Estado</th>
                <th>Creado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="table-body">
              <tr class="loading-row">
                <td colspan="6" class="text-center">Cargando proyectos...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Vista Tarjetas -->
      <div class="tab-content" id="cards-view" role="tabpanel" aria-labelledby="cards">
        <div class="cards-container" id="cards-container">
          <div class="loading-card">Cargando proyectos...</div>
        </div>
      </div>

      <!-- Mensaje de error -->
      <div id="error-message" class="alert alert-error" style="display: none;">
        ✗ Error al cargar los proyectos
      </div>

      <!-- Mensaje vacío -->
      <div id="empty-message" class="empty-state" style="display: none;">
        <div class="empty-icon">📭</div>
        <h3>No hay proyectos</h3>
        <p>Comienza creando tu primer proyecto</p>
        <a href="/nuevo-proyecto" class="btn btn-primary">Crear Proyecto</a>
      </div>
    </div>
  </main>
  </ProtectedRoute>
</BaseLayout>

<script>
  import { AuthService } from '../services/auth';
  import { proyectosHandlers } from '../handlers/proyectos';
  import { getCurrentUserRole, canAccessFinancialData, currentUserHasPermission } from '../utils/permissions';
  import { Permission } from '../types/approval';

  // Verificar autenticación primero
  if (!AuthService.isAuthenticated()) {
    window.location.href = '/login';
  }

  // FASE 2 PERMISOS: Verificar permisos del usuario
  const userRole = getCurrentUserRole();
  const canViewAll = userRole && ['owner', 'admin'].includes(userRole);
  
  if (!canViewAll) {
    // Los miembros y viewers solo ven sus proyectos asignados
    console.log('Usuario con acceso limitado a proyectos');
  }

  // Exposer handlers globalmente
  (window as any).proyectosHandlers = proyectosHandlers;

  // Inicializar
  proyectosHandlers.initializeTabs();
  proyectosHandlers.loadProyectos();
</script>
