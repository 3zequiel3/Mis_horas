---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProtectedRoute from '../components/ProtectedRoute.astro';
import '../styles/dashboard.css';

const pageTitle = 'Dashboard';
---

<BaseLayout title={pageTitle}>
  <ProtectedRoute>
    <Header />
    <main class="container" role="main" aria-label="Panel principal">
      <div class="dashboard">
        <h1>📊 Dashboard</h1>
        
        <div class="stats-grid grid grid-cols-4">
          <div class="stat-card card">
            <div class="stat-label">Proyectos Activos</div>
            <div class="stat-value" id="proyectos-count">0</div>
          </div>
          <div class="stat-card card">
            <div class="stat-label">Horas Totales</div>
            <div class="stat-value" id="total-hours">0h</div>
          </div>
          <div class="stat-card card">
            <div class="stat-label">Horas Esta Semana</div>
            <div class="stat-value" id="week-hours">0h</div>
          </div>
          <div class="stat-card card">
            <div class="stat-label">Promedio Diario</div>
            <div class="stat-value" id="avg-hours">0h</div>
          </div>
        </div>

        <div class="mt-4">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h2>📋 Proyectos Recientes</h2>
            <a href="/proyectos" style="color: var(--tf-color-primary); text-decoration: none; font-weight: 600;">Ver todos →</a>
          </div>
          <div id="proyectos-container" class="projects-grid grid grid-cols-3">
            <div class="loading">Cargando proyectos...</div>
          </div>
        </div>

        <div id="error-message"></div>
      </div>
    </main>
  </ProtectedRoute>
</BaseLayout>

<style>
</style>

<script>
  import { DashboardHandler } from '../handlers/dashboard';
  import { getCurrentUserRole, canAccessFinancialData } from '../utils/permissions';

  // Verificar permisos y ajustar UI
  const userRole = getCurrentUserRole();
  if (userRole && !canAccessFinancialData(userRole)) {
    // Ocultar datos financieros si el usuario no tiene permiso
    console.log('Usuario sin permisos para datos financieros');
  }

  // Cargar el dashboard al montar
  DashboardHandler.cargarDashboard();
</script>
