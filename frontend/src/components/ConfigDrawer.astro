---
/**
 * Drawer de Configuración de Proyecto
 * Componente reutilizable para configurar proyectos desde cualquier tablero
 */
---

<div id="config-drawer" class="config-drawer" role="dialog" aria-modal="true" aria-labelledby="config-drawer-title">
  <div class="drawer-overlay" id="drawer-overlay"></div>
  <div class="drawer-content">
    <div class="drawer-header">
      <h2 id="config-drawer-title">⚙️ Configuración del Proyecto</h2>
      <button class="drawer-close" id="drawer-close">✕</button>
    </div>

    <div class="drawer-body">
      <!-- Tabs -->
      <div class="drawer-tabs">
        <button class="drawer-tab active" data-tab="general">📋 General</button>
        <button class="drawer-tab" data-tab="modules">🧩 Módulos</button>
        <button class="drawer-tab" data-tab="budget">💰 Presupuesto</button>
        <button class="drawer-tab" data-tab="time">⏰ Horarios</button>
      </div>

      <!-- Tab Contents -->
      <div class="drawer-tab-content active" data-tab="general">
        <form id="form-general" class="drawer-form">
          <div class="form-group">
            <label for="client_name">Nombre del Cliente</label>
            <input type="text" id="client_name" class="form-input" placeholder="Cliente (opcional)" />
          </div>

          <div class="form-group">
            <label>Color de Marca</label>
            <div class="color-picker">
              <div class="color-presets">
                <div class="color-preset" data-color="#3B82F6" style="background: #3B82F6;"></div>
                <div class="color-preset" data-color="#10B981" style="background: #10B981;"></div>
                <div class="color-preset" data-color="#F59E0B" style="background: #F59E0B;"></div>
                <div class="color-preset" data-color="#EF4444" style="background: #EF4444;"></div>
                <div class="color-preset" data-color="#8B5CF6" style="background: #8B5CF6;"></div>
                <div class="color-preset" data-color="#EC4899" style="background: #EC4899;"></div>
              </div>
              <div class="color-input-group">
                <input type="color" id="brand_color_picker" class="color-native" />
                <input type="text" id="brand_color" class="form-input" placeholder="#3B82F6" />
              </div>
            </div>
          </div>

          <button type="submit" class="btn-primary">💾 Guardar</button>
        </form>
      </div>

      <div class="drawer-tab-content" data-tab="modules">
        <div class="modules-list">
          <div class="module-item">
            <div class="module-info">
              <span class="module-icon">⏱️</span>
              <div>
                <strong>Time Tracking</strong>
                <small>Seguimiento de horas</small>
              </div>
            </div>
            <label class="toggle">
              <input type="checkbox" class="module-toggle" data-module="time_tracking" checked />
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="module-item">
            <div class="module-info">
              <span class="module-icon">💰</span>
              <div>
                <strong>Presupuesto</strong>
                <small>Control de costos</small>
              </div>
            </div>
            <label class="toggle">
              <input type="checkbox" class="module-toggle" data-module="budget" />
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="module-item">
            <div class="module-info">
              <span class="module-icon">📋</span>
              <div>
                <strong>Auditoría</strong>
                <small>Timeline de cambios</small>
              </div>
            </div>
            <label class="toggle">
              <input type="checkbox" class="module-toggle" data-module="audit" />
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="module-item">
            <div class="module-info">
              <span class="module-icon">✓</span>
              <div>
                <strong>Aprobaciones</strong>
                <small>Flujo de aprobación de períodos</small>
              </div>
            </div>
            <label class="toggle">
              <input type="checkbox" class="module-toggle" data-module="approvals" />
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="module-item">
            <div class="module-info">
              <span class="module-icon">🌐</span>
              <div>
                <strong>Vista Pública</strong>
                <small>Compartir con cliente</small>
              </div>
            </div>
            <label class="toggle">
              <input type="checkbox" class="module-toggle" data-module="public_view" />
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>
        <button id="btn-save-modules" class="btn-primary">💾 Guardar Módulos</button>
      </div>

      <div class="drawer-tab-content" data-tab="budget">
        <form id="form-budget" class="drawer-form">
          <div class="form-group">
            <label>Tipo de Presupuesto</label>
            <select id="budget_type" class="form-input">
              <option value="none">Sin presupuesto</option>
              <option value="fixed_price">💵 Monto Fijo</option>
              <option value="hourly_retainer">⏰ Bolsa de Horas</option>
              <option value="time_and_materials">📊 Por Hora (T&M)</option>
            </select>
          </div>

          <div id="budget-amount-section" style="display: none;">
            <div class="form-row">
              <div class="form-group">
                <label for="budget_base_amount" id="budget-amount-label">Monto</label>
                <input type="number" id="budget_base_amount" class="form-input" min="0" step="0.01" />
              </div>
              <div class="form-group">
                <label for="currency">Moneda</label>
                <select id="currency" class="form-input">
                  <option value="USD">USD 💵</option>
                  <option value="EUR">EUR 💶</option>
                  <option value="ARS">ARS 🇦🇷</option>
                  <option value="MXN">MXN 🇲🇽</option>
                </select>
              </div>
            </div>
          </div>

          <button type="submit" class="btn-primary">💾 Guardar Presupuesto</button>
        </form>
      </div>

      <div class="drawer-tab-content" data-tab="time">
        <form id="form-time" class="drawer-form">
          <div class="setting-item">
            <div class="setting-info">
              <strong>✅ Horas Reales</strong>
              <small>Columna adicional para horas reales</small>
            </div>
            <label class="toggle">
              <input type="checkbox" id="horas_reales_activas" />
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="form-group">
            <label for="modo_horarios">Sistema de Horarios</label>
            <select id="modo_horarios" class="form-input">
              <option value="">Sin horarios</option>
              <option value="corrido">De corrido</option>
              <option value="turnos">Por turnos</option>
            </select>
          </div>

          <div id="config-corrido" style="display: none;">
            <div class="form-row">
              <div class="form-group">
                <label for="horario_inicio">Entrada</label>
                <input type="time" id="horario_inicio" class="form-input" />
              </div>
              <div class="form-group">
                <label for="horario_fin">Salida</label>
                <input type="time" id="horario_fin" class="form-input" />
              </div>
            </div>
          </div>

          <div id="config-turnos" style="display: none;">
            <div class="turno-group">
              <h4>🌅 Turno Mañana</h4>
              <div class="form-row">
                <div class="form-group">
                  <label for="turno_manana_inicio">Inicio</label>
                  <input type="time" id="turno_manana_inicio" class="form-input" />
                </div>
                <div class="form-group">
                  <label for="turno_manana_fin">Fin</label>
                  <input type="time" id="turno_manana_fin" class="form-input" />
                </div>
              </div>
            </div>

            <div class="turno-group">
              <h4>🌆 Turno Tarde</h4>
              <div class="form-row">
                <div class="form-group">
                  <label for="turno_tarde_inicio">Inicio</label>
                  <input type="time" id="turno_tarde_inicio" class="form-input" />
                </div>
                <div class="form-group">
                  <label for="turno_tarde_fin">Fin</label>
                  <input type="time" id="turno_tarde_fin" class="form-input" />
                </div>
              </div>
            </div>
          </div>

          <button type="submit" class="btn-primary">💾 Guardar Horarios</button>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .config-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 9999;
    display: none;
  }

  .config-drawer.active {
    display: block;
  }

  .drawer-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    animation: fadeIn 0.15s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 600px;
    background: var(--tf-bg-elevated);
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.4);
    border-left: 1px solid var(--tf-border);
    display: flex;
    flex-direction: column;
    animation: slideIn 0.2s ease-out;
    will-change: transform;
    transform: translateZ(0);
    will-change: transform;
  }

  @keyframes slideIn {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 2rem 1.5rem 2rem;
    background: var(--tf-bg-surface);
    border-bottom: 2px solid var(--tf-border);
    position: relative;
  }

  .drawer-header h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--tf-color-primary);
    letter-spacing: -0.02em;
  }

  .drawer-close {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    font-weight: 300;
  }

  .drawer-close:hover {
    background: rgba(239, 68, 68, 0.25);
    border-color: rgba(239, 68, 68, 0.5);
    transform: scale(1.05);
  }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(102, 126, 234, 0.3) transparent;
  }

  .drawer-body::-webkit-scrollbar {
    width: 8px;
  }

  .drawer-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .drawer-body::-webkit-scrollbar-thumb {
    background: rgba(102, 126, 234, 0.3);
    border-radius: 4px;
  }

  .drawer-body::-webkit-scrollbar-thumb:hover {
    background: rgba(102, 126, 234, 0.5);
  }

  .drawer-tabs {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(102, 126, 234, 0.3) transparent;
  }

  .drawer-tabs::-webkit-scrollbar {
    height: 4px;
  }

  .drawer-tabs::-webkit-scrollbar-track {
    background: transparent;
  }

  .drawer-tabs::-webkit-scrollbar-thumb {
    background: rgba(102, 126, 234, 0.3);
    border-radius: 2px;
  }

  .drawer-tab {
    padding: 0.875rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    color: var(--tf-text-secondary);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
  }

  .drawer-tab:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(102, 126, 234, 0.3);
    color: var(--tf-text-primary);
    transform: translateY(-2px);
  }

  .drawer-tab.active {
    background: var(--tf-color-primary);
    border-color: transparent;
    color: white;
    box-shadow: var(--tf-shadow-md);
    transform: translateY(-2px);
  }

  .drawer-tab.active::before {
    opacity: 0;
  }

  .drawer-tab-content {
    display: none;
    animation: fadeInContent 0.2s ease-out;
  }

  .drawer-tab-content.active {
    display: block;
  }

  @keyframes fadeInContent {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .drawer-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-group label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--tf-text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .form-group small {
    font-size: 0.85rem;
    color: var(--tf-text-secondary);
    margin-top: -0.25rem;
  }

  .form-input {
    padding: 0.875rem 1rem;
    background: var(--tf-bg-input);
    border: 2px solid var(--tf-border);
    border-radius: 10px;
    color: var(--text-primary, #fff);
    font-size: 0.95rem;
    transition: all 0.15s ease;
    font-family: inherit;
  }

  .form-input::placeholder {
    color: rgba(156, 163, 175, 0.5);
  }

  .form-input:hover {
    border-color: var(--tf-border-hover);
    background: rgba(255, 255, 255, 0.06);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--tf-color-primary);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.2);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .btn-primary {
    padding: 1rem 1.75rem;
    background: var(--tf-color-primary);
    border: none;
    border-radius: 10px;
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: var(--tf-shadow-sm);
  }

  .btn-primary:hover {
    background: var(--tf-color-primary-hover);
    box-shadow: var(--tf-shadow-md);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  /* Color Picker */
  .color-picker {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
  }

  .color-presets {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .color-preset {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    cursor: pointer;
    border: 3px solid rgba(255, 255, 255, 0.1);
    transition: all 0.15s ease;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .color-preset::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 14px;
    border: 2px solid transparent;
    transition: all 0.15s ease;
  }

  .color-preset:hover {
    transform: scale(1.15) translateY(-2px);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
  }

  .color-preset.selected {
    border-color: white;
    box-shadow: 0 2px 8px rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
  }

  .color-preset.selected::after {
    border-color: rgba(255, 255, 255, 0.5);
  }

  .color-input-group {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .color-native {
    width: 60px;
    height: 48px;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.15s ease;
    background: transparent;
  }

  .color-native:hover {
    border-color: rgba(102, 126, 234, 0.5);
  }

  /* Modules */
  .modules-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .module-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: var(--tf-bg-surface);
    border: 2px solid var(--tf-border);
    border-radius: 12px;
    transition: all 0.15s ease;
    position: relative;
  }

  .module-item:hover {
    background: var(--tf-bg-elevated);
    border-color: var(--tf-border-hover);
  }

  .module-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .module-icon {
    font-size: 2rem;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(102, 126, 234, 0.15);
    border-radius: 10px;
    border: 1px solid rgba(102, 126, 234, 0.3);
  }

  .module-info strong {
    display: block;
    color: var(--tf-text-primary);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .module-info small {
    display: block;
    color: var(--tf-text-secondary);
    font-size: 0.85rem;
  }

  /* Toggle Switch */
  .toggle {
    position: relative;
    display: inline-block;
    width: 56px;
    height: 30px;
  }

  .toggle input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background: rgba(255, 255, 255, 0.15);
    transition: all 0.15s ease;
    border-radius: 30px;
    border: 2px solid rgba(255, 255, 255, 0.1);
  }

  .toggle-slider:before {
    position: absolute;
    content: "";
    height: 22px;
    width: 22px;
    left: 3px;
    bottom: 2px;
    background: #ffffff;
    transition: all 0.15s ease;
    border-radius: 50%;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  .toggle:hover .toggle-slider {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(102, 126, 234, 0.3);
  }

  input:checked + .toggle-slider {
    background: var(--tf-color-primary);
    border-color: transparent;
  }

  input:checked + .toggle-slider:before {
    transform: translateX(26px);
    background: #ffffff;
    box-shadow: 0 1px 4px rgba(102, 126, 234, 0.4);
  }

  input:checked:hover + .toggle-slider {
    background: var(--tf-color-primary-hover);
  }

  /* Settings Item */
  .setting-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: var(--tf-bg-surface);
    border: 2px solid var(--tf-border);
    border-radius: 12px;
    margin-bottom: 2rem;
    transition: all 0.15s ease;
  }

  .setting-item:hover {
    background: var(--tf-bg-elevated);
    border-color: var(--tf-border-hover);
  }

  .setting-info strong {
    display: block;
    color: var(--tf-text-primary);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  .setting-info small {
    display: block;
    color: var(--tf-text-secondary);
    font-size: 0.85rem;
  }

  /* Turno Group */
  .turno-group {
    padding: 1.5rem;
    background: var(--tf-bg-surface);
    border: 2px solid var(--tf-border);
    border-radius: 12px;
    margin-bottom: 1.25rem;
    transition: all 0.15s ease;
  }

  .turno-group:hover {
    border-color: rgba(102, 126, 234, 0.35);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.15);
  }

  .turno-group h4 {
    margin: 0 0 1.25rem 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary, #fff);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .drawer-content {
      max-width: 100%;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .drawer-tabs {
      gap: 0.25rem;
    }

    .drawer-tab {
      font-size: 0.8rem;
      padding: 0.6rem 0.8rem;
    }
  }
</style>
