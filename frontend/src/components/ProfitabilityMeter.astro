---
/**
 * Profitability Meter Component
 * Widget de rentabilidad con indicador visual
 * Fase 4: UX Unificada & Gestión Financiera
 */

interface Props {
  profitMargin: number;
  totalRevenue: number;
  totalCost: number;
  netProfit: number;
  currency: string;
  className?: string;
  showDetails?: boolean;
}

const {
  profitMargin,
  totalRevenue,
  totalCost,
  netProfit,
  currency,
  className = '',
  showDetails = true
} = Astro.props;

// Determinar health status según margen
const getHealthStatus = (margin: number): 'healthy' | 'warning' | 'critical' | 'losing' => {
  if (margin >= 30) return 'healthy';
  if (margin >= 10) return 'warning';
  if (margin >= 0) return 'critical';
  return 'losing';
};

const healthStatus = getHealthStatus(profitMargin);

// Configuración de colores y labels
const healthConfig = {
  healthy: {
    label: 'Excelente',
    color: 'text-green-600',
    bgColor: 'bg-green-100',
    ringColor: 'ring-green-500',
    icon: '✓'
  },
  warning: {
    label: 'Aceptable',
    color: 'text-yellow-600',
    bgColor: 'bg-yellow-100',
    ringColor: 'ring-yellow-500',
    icon: '⚠'
  },
  critical: {
    label: 'Bajo',
    color: 'text-orange-600',
    bgColor: 'bg-orange-100',
    ringColor: 'ring-orange-500',
    icon: '!'
  },
  losing: {
    label: 'Pérdida',
    color: 'text-red-600',
    bgColor: 'bg-red-100',
    ringColor: 'ring-red-500',
    icon: '✕'
  }
};

const config = healthConfig[healthStatus];

// Formatear montos
const formatAmount = (amount: number): string => {
  const symbols: Record<string, string> = {
    'USD': '$',
    'EUR': '€',
    'ARS': '$',
    'MXN': '$',
    'BRL': 'R$'
  };
  
  const symbol = symbols[currency] || currency;
  const absAmount = Math.abs(amount);
  const formatted = absAmount.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  
  return amount < 0 ? `-${symbol}${formatted}` : `${symbol}${formatted}`;
};

// Calcular ángulo del medidor (0-180 grados)
// -50% = 0°, 0% = 90°, 50% = 180°
const calculateAngle = (margin: number): number => {
  const clampedMargin = Math.max(-50, Math.min(50, margin));
  return ((clampedMargin + 50) / 100) * 180;
};

const needleAngle = calculateAngle(profitMargin);
---

<div class={`profitability-widget ${className}`}>
  <!-- Header -->
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-sm font-semibold text-gray-700">Rentabilidad</h3>
    <span class={`px-2 py-1 rounded-full text-xs font-medium ${config.bgColor} ${config.color}`}>
      {config.icon} {config.label}
    </span>
  </div>

  <!-- Medidor Circular -->
  <div class="relative flex justify-center items-center mb-4">
    <!-- Arco del medidor -->
    <svg class="w-48 h-24 -mb-4" viewBox="0 0 200 100">
      <!-- Arco rojo (pérdida) -->
      <path
        d="M 10 90 A 90 90 0 0 1 65 20"
        fill="none"
        stroke="#fecaca"
        stroke-width="12"
        stroke-linecap="round"
      />
      <!-- Arco naranja (bajo) -->
      <path
        d="M 65 20 A 90 90 0 0 1 100 10"
        fill="none"
        stroke="#fed7aa"
        stroke-width="12"
        stroke-linecap="round"
      />
      <!-- Arco amarillo (aceptable) -->
      <path
        d="M 100 10 A 90 90 0 0 1 135 20"
        fill="none"
        stroke="#fef08a"
        stroke-width="12"
        stroke-linecap="round"
      />
      <!-- Arco verde (excelente) -->
      <path
        d="M 135 20 A 90 90 0 0 1 190 90"
        fill="none"
        stroke="#bbf7d0"
        stroke-width="12"
        stroke-linecap="round"
      />
      
      <!-- Aguja -->
      <line
        x1="100"
        y1="90"
        x2="100"
        y2="20"
        stroke={config.color.replace('text-', '#')}
        stroke-width="3"
        stroke-linecap="round"
        style={`transform: rotate(${needleAngle}deg); transform-origin: 100px 90px; transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);`}
      />
      
      <!-- Centro de la aguja -->
      <circle cx="100" cy="90" r="6" class={config.bgColor} stroke="white" stroke-width="2"/>
    </svg>

    <!-- Porcentaje central -->
    <div class="absolute top-12 text-center">
      <div class={`text-3xl font-bold ${config.color}`}>
        {profitMargin.toFixed(1)}%
      </div>
      <div class="text-xs text-gray-500 mt-1">Margen</div>
    </div>
  </div>

  <!-- Detalles Financieros -->
  {showDetails && (
    <div class="space-y-2 mt-4 pt-4 border-t border-gray-200">
      <!-- Ingresos -->
      <div class="flex justify-between items-center">
        <span class="text-xs text-gray-600">Ingresos facturables</span>
        <span class="text-sm font-semibold text-green-600">
          {formatAmount(totalRevenue)}
        </span>
      </div>
      
      <!-- Costos -->
      <div class="flex justify-between items-center">
        <span class="text-xs text-gray-600">Costos totales</span>
        <span class="text-sm font-semibold text-red-600">
          {formatAmount(totalCost)}
        </span>
      </div>
      
      <!-- Ganancia Neta -->
      <div class="flex justify-between items-center pt-2 border-t border-gray-100">
        <span class="text-xs font-medium text-gray-700">Ganancia neta</span>
        <span class={`text-lg font-bold ${netProfit >= 0 ? 'text-green-600' : 'text-red-600'}`}>
          {formatAmount(netProfit)}
        </span>
      </div>
    </div>
  )}

  <!-- Help text -->
  <div class="mt-4 text-xs text-gray-500 text-center">
    <span class="inline-block">
      {healthStatus === 'healthy' && 'Rentabilidad saludable (>30%)'}
      {healthStatus === 'warning' && 'Rentabilidad aceptable (10-30%)'}
      {healthStatus === 'critical' && 'Rentabilidad baja (0-10%)'}
      {healthStatus === 'losing' && 'Proyecto con pérdidas (<0%)'}
    </span>
  </div>
</div>

<style>
  .profitability-widget {
    @apply bg-white rounded-lg p-5 shadow-sm border border-gray-200;
  }

  /* Animación suave para la aguja */
  svg line {
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Hover effect */
  .profitability-widget:hover {
    @apply shadow-md border-gray-300;
    transition: all 0.2s ease;
  }
</style>
