---
/**
 * Componente de protección de rutas
 * Verifica autenticación en el CLIENTE (no en servidor)
 * Redirige a login si no está autenticado
 */

interface Props {
  children?: any;
}

const { children } = Astro.props;
---

<div id="protected-route-wrapper">
  <slot />
</div>

<script>
  import { AuthService } from '../services/auth';

  const AUTH_SYNC_EVENT = 'auth_sync_event';

  // Verificar autenticación inmediatamente
  function checkAuth() {
    if (!AuthService.isAuthenticated()) {
      console.warn('No autenticado - redirigiendo a login');
      window.location.href = '/login';
      return false;
    }
    return true;
  }

  // Ejecutar inmediatamente
  checkAuth();

  // Re-validar auth cuando cambia en otra pestaña o en el mismo contexto
  window.addEventListener('storage', (event) => {
    if (event.key === AUTH_SYNC_EVENT) {
      checkAuth();
    }
  });

  window.addEventListener('auth-state-changed', () => {
    checkAuth();
  });

  // Disparar evento personalizado cuando la autenticación está verificada
  if (AuthService.isAuthenticated()) {
    window.dispatchEvent(new CustomEvent('auth-verified'));
  }
</script>
