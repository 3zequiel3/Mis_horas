---
import Notificaciones from './Notificaciones.astro';
import OrganizationSelector from './OrganizationSelector.astro';

interface Props {
  children?: string;
}

const { children } = Astro.props;
---

<header class="header">
  <nav class="navbar" role="navigation" aria-label="Navegación principal">
    <div class="container navbar-content">
      <div class="nav-brand">
        <h1>⏱️ TimeFlow</h1>
      </div>
      
      <button class="hamburger-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="nav-menu" id="nav-menu">
        <OrganizationSelector />
        <a href="/dashboard" class="nav-link">Dashboard</a>
        <a href="/proyectos" class="nav-link">Proyectos</a>
        <a href="/nuevo-proyecto" class="nav-link nav-link-primary">+ Nuevo</a>
        <Notificaciones />
        <a href="/perfil" class="nav-link">Perfil</a>
        <button id="logout-btn" class="btn btn-danger btn-sm">Cerrar Sesión</button>
      </div>
    </div>
  </nav>
</header>

<style>
  .header {
    background: var(--tf-bg-surface);
    color: var(--tf-text-primary);
    padding: 1rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--tf-border);
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .nav-brand h1 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--tf-color-primary);
    font-weight: 700;
  }
  
  .nav-brand h1::first-letter {
    /* Mantener emojis visibles */
    background: none;
    -webkit-text-fill-color: currentColor;
  }

  .nav-menu {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-link {
    color: var(--tf-text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border-radius: var(--tf-radius-sm);
  }

  .nav-link:hover {
    color: var(--tf-text-primary);
    background: var(--tf-bg-input);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--tf-color-primary);
    outline-offset: 2px;
  }

  .nav-link[aria-current="page"] {
    color: var(--tf-color-primary);
    background: rgba(102, 126, 234, 0.1);
  }

  .nav-link-primary {
    background: var(--tf-color-primary);
    color: white !important;
    padding: 0.5rem 1.25rem;
    border-radius: var(--tf-radius-md);
    border: none;
    cursor: pointer;
    font-weight: 500;
    font-family: inherit;
    font-size: inherit;
  }

  .nav-link-primary:hover {
    background: var(--tf-color-primary-hover);
  }

  .nav-link-primary:focus-visible {
    outline: 2px solid var(--tf-color-primary);
    outline-offset: 2px;
  }

  /* Hamburger Menu */
  .hamburger-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
  }

  .hamburger-toggle span {
    display: block;
    width: 25px;
    height: 3px;
    background: var(--tf-text-primary);
    border-radius: 3px;
    transition: all 0.3s ease;
  }

  .hamburger-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .hamburger-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .hamburger-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  @media (max-width: 768px) {
    .hamburger-toggle {
      display: flex;
    }

    .navbar-content {
      position: relative;
    }

    .nav-menu {
      position: fixed;
      top: 0;
      right: -100%;
      width: 280px;
      height: 100vh;
      background: var(--tf-bg-surface);
      flex-direction: column;
      gap: 0;
      padding: 5rem 0 2rem 0;
      border-left: 1px solid var(--tf-border);
      transition: right 0.3s ease;
      z-index: 1000;
      overflow-y: auto;
    }

    .nav-menu.active {
      right: 0;
    }

    .nav-link {
      width: 100%;
      text-align: left;
      padding: 1rem 2rem;
      border-bottom: 1px solid var(--tf-border);
      border-radius: 0;
      transition: all 0.2s ease;
    }

    .nav-link:hover {
      background: var(--tf-bg-input);
      padding-left: 2.5rem;
    }

    .nav-link-primary {
      margin: 1rem 2rem;
      width: calc(100% - 4rem);
      text-align: center;
      padding: 0.75rem 1rem;
      border: none;
      cursor: pointer;
    }

    .nav-link-primary:hover {
      transform: translateY(0);
      padding-left: 1rem;
    }

    #logout-btn {
      margin: 1rem 2rem;
      width: calc(100% - 4rem);
    }

    .nav-brand h1 {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  import { AlertUtils } from '../utils/swal';
  import { authHandlers } from '../handlers/auth';
  import { initHamburgerMenu } from '../utils/hamburger';
  import { getCurrentUserRole, canApproveTimesheets, isPersonalMode } from '../utils/permissions';
  import { organizationService } from '../services/organizationService';

  // Inicializar menú hamburguesa
  initHamburgerMenu();

  // Marcar link activo con aria-current="page"
  const currentPath = window.location.pathname;
  document.querySelectorAll<HTMLAnchorElement>('.nav-link[href]').forEach(link => {
    const href = link.getAttribute('href');
    if (href && (currentPath === href || currentPath.startsWith(href + '/'))) {
      link.setAttribute('aria-current', 'page');
    }
  });

  // Sincronizar aria-expanded del hamburger
  const hamburger = document.querySelector('.hamburger-toggle');
  if (hamburger) {
    const observer = new MutationObserver(() => {
      const isActive = hamburger.classList.contains('active');
      hamburger.setAttribute('aria-expanded', String(isActive));
    });
    observer.observe(hamburger, { attributes: true, attributeFilter: ['class'] });
  }

  // FASE 2 PERMISOS: Mostrar/ocultar enlaces según permisos y modo organizacional
  async function adjustMenuByPermissions() {
    try {
      // Verificar si hay token de autenticación antes de hacer llamadas
      const token = localStorage.getItem('token');
      if (!token) {
        // Sin token, ocultar todas las opciones de permisos avanzados
        const aprobacionesLink = document.getElementById('nav-aprobaciones');
        const auditoriaLink = document.getElementById('nav-auditoria');
        if (aprobacionesLink) aprobacionesLink.style.display = 'none';
        if (auditoriaLink) auditoriaLink.style.display = 'none';
        return;
      }

      const userRole = getCurrentUserRole();
      const organizations = await organizationService.getAll();
      const currentOrgId = organizationService.getCurrentOrganizationId();
      const currentOrg = organizations.find(o => o.id === currentOrgId);

      // Ocultar "Aprobaciones" si no tiene permiso o está en modo personal
      const aprobacionesLink = document.getElementById('nav-aprobaciones');
      if (aprobacionesLink) {
        const shouldShow = userRole && canApproveTimesheets(userRole) && currentOrg && !isPersonalMode(currentOrg);
        aprobacionesLink.style.display = shouldShow ? 'block' : 'none';
      }

      // Ocultar "Auditoría" para viewers
      const auditoriaLink = document.getElementById('nav-auditoria');
      if (auditoriaLink) {
        const shouldShow = userRole && ['owner', 'admin', 'manager'].includes(userRole);
        auditoriaLink.style.display = shouldShow ? 'block' : 'none';
      }
    } catch (error) {
      // Si hay error (401, etc), silenciosamente ocultar opciones de permisos
      console.log('No se pudo ajustar menú por permisos (usuario no autenticado o sin permisos)');
      const aprobacionesLink = document.getElementById('nav-aprobaciones');
      const auditoriaLink = document.getElementById('nav-auditoria');
      if (aprobacionesLink) aprobacionesLink.style.display = 'none';
      if (auditoriaLink) auditoriaLink.style.display = 'none';
    }
  }

  // Ejecutar al cargar solo si estamos autenticados y no en páginas públicas
  const publicPages = ['/login', '/register', '/'];
  const isPublicPage = publicPages.some(page => window.location.pathname === page || window.location.pathname.startsWith(page + '?'));
  
  if (localStorage.getItem('token') && !isPublicPage) {
    adjustMenuByPermissions();
  }

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    const result = await AlertUtils.confirm(
      '¿Cerrar Sesión?',
      'Serás desconectado de tu cuenta',
      'Sí, cerrar sesión',
      'Cancelar'
    );

    if (result.isConfirmed) {
      try {
        await authHandlers.logout();
      } catch (error) {
        console.error('Error al cerrar sesión:', error);
        await AlertUtils.error('Error', 'No se pudo cerrar la sesión');
      }
    }
  });
</script>
