---
/**
 * SuperWizard Component
 * Wizard de creación de proyectos con stepper dinámico
 * Fase 4: UX Unificada & Gestión Financiera
 * 
 * Pasos condicionales según configuración
 */

import { API_BASE_URL } from '../utils/api';

interface Props {
  organizationType?: 'personal' | 'freelance' | 'empresa';
}

const { organizationType = 'personal' } = Astro.props;

/**
 * P2.4 NOTE: Este componente es candidato para refactorización a React con `client:visible`.
 * Directiva propuesta: client:visible (Se hidrata cuando es visible en viewport)
 * Razón: Wizard de creación es deferred (no en critical path)
 */
---

<script define:vars={{ API_BASE_URL }}>
  // Hacer disponible API_BASE_URL globalmente para Alpine.js
  if (typeof window !== 'undefined') {
    window.API_BASE_URL = API_BASE_URL;
    
    // Helper para obtener headers de autenticación
    window.getAuthHeaders = function() {
      const token = localStorage.getItem('token');
      const orgId = localStorage.getItem('currentOrganizationId');
      const headers = {
        'Content-Type': 'application/json'
      };
      if (token) headers['Authorization'] = `Bearer ${token}`;
      if (orgId) headers['X-Organization-ID'] = orgId;
      return headers;
    };
  }
</script>

<div 
  x-data="{
    currentStep: 1,
    organizationType: '{organizationType}',
    
    // Datos del formulario
    formData: {
      nombre: '',
      descripcion: '',
      client_name: '',
      brand_color: '#3B82F6',
      modules_config: {
        budget: false,
        time_tracking: true,
        audit: false,
        approvals: false,
        public_view: false
      },
      budget_type: 'none',
      budget_base_amount: null,
      currency: 'USD',
      team_members: []
    },
    
    // Colores preset
    presetColors: ['#3B82F6', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899'],
    
    // Pasos totales (dinámico)
    get totalSteps() {
      let steps = 2; // Identidad + Módulos siempre
      if (this.formData.modules_config.budget) steps++; // Estrategia Financiera
      if (this.organizationType === 'empresa') steps++; // Equipo
      return steps;
    },
    
    // Obtener número de paso de Estrategia Financiera
    get financialStepNumber() {
      return 3; // Siempre después de Módulos
    },
    
    // Obtener número de paso de Equipo
    get teamStepNumber() {
      return this.formData.modules_config.budget ? 4 : 3;
    },
    
    // Validación por paso
    canProceed() {
      if (this.currentStep === 1) {
        return this.formData.nombre.trim() !== '';
      }
      if (this.currentStep === this.financialStepNumber && this.formData.modules_config.budget) {
        return this.formData.budget_type !== 'none';
      }
      return true;
    },
    
    nextStep() {
      if (!this.canProceed()) {
        alert('Por favor completa los campos requeridos');
        return;
      }
      
      // Si estamos en Módulos y budget está OFF, saltar paso Finanzas
      if (this.currentStep === 2 && !this.formData.modules_config.budget) {
        if (this.organizationType === 'empresa') {
          this.currentStep = this.teamStepNumber;
        } else {
          this.submit(); // Terminar
        }
      } else if (this.currentStep === this.financialStepNumber && this.organizationType !== 'empresa') {
        this.submit(); // Terminar
      } else {
        this.currentStep++;
      }
    },
    
    prevStep() {
      // Si retrocedemos desde Equipo y budget OFF, volver a Módulos
      if (this.currentStep === this.teamStepNumber && !this.formData.modules_config.budget) {
        this.currentStep = 2;
      } else {
        this.currentStep--;
      }
    },
    
    async submit() {
      const token = localStorage.getItem('token');
      const orgId = localStorage.getItem('currentOrganizationId');
      
      try {
        const response = await fetch(`${window.API_BASE_URL}/api/proyectos`, {
          method: 'POST',
          headers: window.getAuthHeaders(),
          body: JSON.stringify(this.formData)
        });
        
        if (response.ok) {
          const data = await response.json();
          window.location.href = `/proyecto/${data.data.id}`;
        } else {
          alert('Error al crear el proyecto');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error al crear el proyecto');
      }
    }
  }"
  class="max-w-4xl mx-auto"
>
  <!-- Stepper Header -->
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <!-- Step 1: Identidad -->
      <div class="flex items-center">
        <div 
          :class="currentStep > 1 ? 'bg-[var(--tf-color-success)] text-white' : currentStep === 1 ? 'bg-[var(--tf-color-primary)] text-white' : 'bg-[var(--tf-bg-surface)] text-[var(--tf-text-secondary)]'"
          class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-colors"
        >
          <span x-show="currentStep <= 1">1</span>
          <svg x-show="currentStep > 1" class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </div>
        <span class="ml-2 text-sm font-medium">Identidad</span>
      </div>

      <div class="flex-1 h-1 mx-2 bg-[var(--tf-bg-surface)] rounded">
        <div 
          :style="`width: ${currentStep > 1 ? 100 : 0}%`"
          class="h-full bg-[var(--tf-color-primary)] transition-all duration-500"
        ></div>
      </div>

      <!-- Step 2: Módulos -->
      <div class="flex items-center">
        <div 
          :class="currentStep > 2 ? 'bg-[var(--tf-color-success)] text-white' : currentStep === 2 ? 'bg-[var(--tf-color-primary)] text-white' : 'bg-[var(--tf-bg-surface)] text-[var(--tf-text-secondary)]'"
          class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-colors"
        >
          <span x-show="currentStep <= 2">2</span>
          <svg x-show="currentStep > 2" class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </div>
        <span class="ml-2 text-sm font-medium">Módulos</span>
      </div>

      <!-- Step 3: Finanzas (condicional) -->
      <template x-if="formData.modules_config.budget">
        <>
          <div class="flex-1 h-1 mx-2 bg-[var(--tf-bg-surface)] rounded">
            <div 
              :style="`width: ${currentStep > financialStepNumber ? 100 : 0}%`"
              class="h-full bg-[var(--tf-color-primary)] transition-all duration-500"
            ></div>
          </div>

          <div class="flex items-center">
            <div 
              :class="currentStep > financialStepNumber ? 'bg-[var(--tf-color-success)] text-white' : currentStep === financialStepNumber ? 'bg-[var(--tf-color-primary)] text-white' : 'bg-[var(--tf-bg-surface)] text-[var(--tf-text-secondary)]'"
              class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-colors"
            >
              <span x-show="currentStep <= financialStepNumber">3</span>
              <svg x-show="currentStep > financialStepNumber" class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="ml-2 text-sm font-medium">Finanzas</span>
          </div>
        </>
      </template>

      <!-- Step 4: Equipo (condicional) -->
      <template x-if="organizationType === 'empresa'">
        <>
          <div class="flex-1 h-1 mx-2 bg-[var(--tf-bg-surface)] rounded">
            <div 
              :style="`width: ${currentStep > teamStepNumber ? 100 : 0}%`"
              class="h-full bg-[var(--tf-color-primary)] transition-all duration-500"
            ></div>
          </div>

          <div class="flex items-center">
            <div 
              :class="currentStep === teamStepNumber ? 'bg-[var(--tf-color-primary)] text-white' : 'bg-[var(--tf-bg-surface)] text-[var(--tf-text-secondary)]'"
              class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-colors"
            >
              <span x-text="teamStepNumber"></span>
            </div>
            <span class="ml-2 text-sm font-medium">Equipo</span>
          </div>
        </>
      </template>
    </div>
  </div>

  <!-- Form Content -->
  <div class="bg-[var(--tf-bg-elevated)] rounded-lg shadow-lg p-8 border border-[var(--tf-border)]" role="form" aria-label="Crear nuevo proyecto">
    <!-- Step 1: Identidad -->
    <div x-show="currentStep === 1" class="space-y-6">
      <h3 class="text-2xl font-bold text-[var(--tf-text-primary)]">Identidad del Proyecto</h3>

      <div>
        <label class="block text-sm font-medium text-[var(--tf-text-primary)] mb-1">
          Nombre del proyecto <span class="text-[var(--tf-color-danger)]">*</span>
        </label>
        <input
          type="text"
          x-model="formData.nombre"
          placeholder="ej: Plataforma E-commerce"
          class="w-full px-4 py-2 border border-[var(--tf-border)] rounded-md focus:ring-2 focus:ring-[var(--tf-color-primary)] focus:border-[var(--tf-color-primary)]"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-[var(--tf-text-primary)] mb-1">Descripción</label>
        <textarea
          x-model="formData.descripcion"
          rows="4"
          placeholder="Breve descripción del proyecto..."
          class="w-full px-4 py-2 border border-[var(--tf-border)] rounded-md focus:ring-2 focus:ring-[var(--tf-color-primary)] focus:border-[var(--tf-color-primary)]"
        ></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-[var(--tf-text-primary)] mb-1">Cliente</label>
        <input
          type="text"
          x-model="formData.client_name"
          placeholder="Nombre del cliente (opcional)"
          class="w-full px-4 py-2 border border-[var(--tf-border)] rounded-md focus:ring-2 focus:ring-[var(--tf-color-primary)] focus:border-[var(--tf-color-primary)]"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-[var(--tf-text-primary)] mb-2">Color de marca</label>
        <div class="flex items-center space-x-3 mb-3">
          <template x-for="color in presetColors" :key="color">
            <button
              type="button"
              @click="formData.brand_color = color"
              :style="`background-color: ${color}`"
              :class="formData.brand_color === color ? 'ring-4 ring-[var(--tf-color-primary)]' : ''"
              class="w-10 h-10 rounded-full transition-all hover:scale-110"
            ></button>
          </template>
        </div>
        <div class="flex items-center space-x-3">
          <input
            type="color"
            x-model="formData.brand_color"
            class="h-10 w-20 rounded border border-[var(--tf-border)]"
          />
          <input
            type="text"
            x-model="formData.brand_color"
            class="flex-1 px-4 py-2 border border-[var(--tf-border)] rounded-md focus:ring-2 focus:ring-[var(--tf-color-primary)] focus:border-[var(--tf-color-primary)]"
          />
        </div>
      </div>
    </div>

    <!-- Step 2: Módulos -->
    <div x-show="currentStep === 2" class="space-y-6">
      <h3 class="text-2xl font-bold text-[var(--tf-text-primary)]">Módulos del Proyecto</h3>
      <p class="text-[var(--tf-text-secondary)]">Selecciona las funcionalidades que necesitas</p>

      <div class="grid grid-cols-2 gap-4">
        <!-- Presupuesto -->
        <button
          type="button"
          @click="formData.modules_config.budget = !formData.modules_config.budget"
          :class="formData.modules_config.budget ? 'ring-4 ring-[var(--tf-color-primary)] bg-[var(--tf-bg-surface)]' : 'bg-[var(--tf-bg-elevated)]'"
          class="p-6 border-2 border-[var(--tf-border)] rounded-lg text-left hover:border-[var(--tf-border-hover)] transition-all"
        >
          <div class="text-4xl mb-3">💰</div>
          <h4 class="font-semibold text-[var(--tf-text-primary)] mb-1">Gestión de Presupuesto</h4>
          <p class="text-sm text-[var(--tf-text-secondary)]">Control de costos y burn rate</p>
        </button>

        <!-- Time Tracking -->
        <button
          type="button"
          @click="formData.modules_config.time_tracking = !formData.modules_config.time_tracking"
          :class="formData.modules_config.time_tracking ? 'ring-4 ring-[var(--tf-color-primary)] bg-[var(--tf-bg-surface)]' : 'bg-[var(--tf-bg-elevated)]'"
          class="p-6 border-2 border-[var(--tf-border)] rounded-lg text-left hover:border-[var(--tf-border-hover)] transition-all"
        >
          <div class="text-4xl mb-3">⏱️</div>
          <h4 class="font-semibold text-[var(--tf-text-primary)] mb-1">Seguimiento de Tiempo</h4>
          <p class="text-sm text-[var(--tf-text-secondary)]">Registro de horas trabajadas</p>
        </button>

        <!-- Auditoría -->
        <button
          type="button"
          @click="formData.modules_config.audit = !formData.modules_config.audit"
          :class="formData.modules_config.audit ? 'ring-4 ring-[var(--tf-color-primary)] bg-[var(--tf-bg-surface)]' : 'bg-[var(--tf-bg-elevated)]'"
          class="p-6 border-2 border-[var(--tf-border)] rounded-lg text-left hover:border-[var(--tf-border-hover)] transition-all"
        >
          <div class="text-4xl mb-3">📋</div>
          <h4 class="font-semibold text-[var(--tf-text-primary)] mb-1">Auditoría</h4>
          <p class="text-sm text-[var(--tf-text-secondary)]">Timeline de cambios y acciones</p>
        </button>

        <!-- Aprobaciones -->
        <button
          type="button"
          @click="formData.modules_config.approvals = !formData.modules_config.approvals"
          :class="formData.modules_config.approvals ? 'ring-4 ring-[var(--tf-color-primary)] bg-[var(--tf-bg-surface)]' : 'bg-[var(--tf-bg-elevated)]'"
          class="p-6 border-2 border-[var(--tf-border)] rounded-lg text-left hover:border-[var(--tf-border-hover)] transition-all"
        >
          <div class="text-4xl mb-3">✓</div>
          <h4 class="font-semibold text-[var(--tf-text-primary)] mb-1">Aprobaciones</h4>
          <p class="text-sm text-[var(--tf-text-secondary)]">Flujo de aprobación de períodos</p>
        </button>

        <!-- Vista Pública -->
        <button
          type="button"
          @click="formData.modules_config.public_view = !formData.modules_config.public_view"
          :class="formData.modules_config.public_view ? 'ring-4 ring-[var(--tf-color-primary)] bg-[var(--tf-bg-surface)]' : 'bg-[var(--tf-bg-elevated)]'"
          class="p-6 border-2 border-[var(--tf-border)] rounded-lg text-left hover:border-[var(--tf-border-hover)] transition-all"
        >
          <div class="text-4xl mb-3">🌐</div>
          <h4 class="font-semibold text-[var(--tf-text-primary)] mb-1">Vista Pública</h4>
          <p class="text-sm text-[var(--tf-text-secondary)]">Compartir progreso con cliente</p>
        </button>
      </div>
    </div>

    <!-- Step 3: Estrategia Financiera (condicional) -->
    <div x-show="currentStep === financialStepNumber && formData.modules_config.budget" class="space-y-6">
      <h3 class="text-2xl font-bold text-[var(--tf-text-primary)]">Estrategia Financiera</h3>
      <p class="text-[var(--tf-text-secondary)]">¿Cómo se facturará este proyecto?</p>

      <div class="grid grid-cols-3 gap-4">
        <!-- Monto Fijo -->
        <button
          type="button"
          @click="formData.budget_type = 'fixed_price'"
          :class="formData.budget_type === 'fixed_price' ? 'ring-4 ring-[var(--tf-color-primary)] bg-[var(--tf-bg-surface)]' : 'bg-[var(--tf-bg-elevated)]'"
          class="p-6 border-2 border-[var(--tf-border)] rounded-lg text-center hover:border-[var(--tf-border-hover)] transition-all"
        >
          <div class="text-4xl mb-3">💵</div>
          <h4 class="font-semibold text-[var(--tf-text-primary)] mb-1">Monto Fijo</h4>
          <p class="text-xs text-[var(--tf-text-secondary)]">Precio cerrado por proyecto</p>
        </button>

        <!-- Bolsa de Horas -->
        <button
          type="button"
          @click="formData.budget_type = 'hourly_retainer'"
          :class="formData.budget_type === 'hourly_retainer' ? 'ring-4 ring-[var(--tf-color-primary)] bg-[var(--tf-bg-surface)]' : 'bg-[var(--tf-bg-elevated)]'"
          class="p-6 border-2 border-[var(--tf-border)] rounded-lg text-center hover:border-[var(--tf-border-hover)] transition-all"
        >
          <div class="text-4xl mb-3">⏰</div>
          <h4 class="font-semibold text-[var(--tf-text-primary)] mb-1">Bolsa de Horas</h4>
          <p class="text-xs text-[var(--tf-text-secondary)]">Cantidad de horas contratadas</p>
        </button>

        <!-- Time & Materials -->
        <button
          type="button"
          @click="formData.budget_type = 'time_and_materials'"
          :class="formData.budget_type === 'time_and_materials' ? 'ring-4 ring-[var(--tf-color-primary)] bg-[var(--tf-bg-surface)]' : 'bg-[var(--tf-bg-elevated)]'"
          class="p-6 border-2 border-[var(--tf-border)] rounded-lg text-center hover:border-[var(--tf-border-hover)] transition-all"
        >
          <div class="text-4xl mb-3">📊</div>
          <h4 class="font-semibold text-[var(--tf-text-primary)] mb-1">Por Hora (T&M)</h4>
          <p class="text-xs text-[var(--tf-text-secondary)]">Facturación por tiempo real</p>
        </button>
      </div>

      <!-- Inputs según tipo -->
      <div x-show="formData.budget_type === 'fixed_price'" class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-[var(--tf-text-primary)] mb-1">Moneda</label>
          <select
            x-model="formData.currency"
            class="w-full px-4 py-2 border border-[var(--tf-border)] rounded-md focus:ring-2 focus:ring-[var(--tf-color-primary)]"
          >
            <option value="USD">🇺🇸 USD - Dólar</option>
            <option value="EUR">🇪🇺 EUR - Euro</option>
            <option value="ARS">🇦🇷 ARS - Peso Argentino</option>
            <option value="MXN">🇲🇽 MXN - Peso Mexicano</option>
            <option value="CLP">🇨🇱 CLP - Peso Chileno</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-[var(--tf-text-primary)] mb-1">Monto</label>
          <input
            type="number"
            x-model="formData.budget_base_amount"
            placeholder="50000"
            class="w-full px-4 py-2 border border-[var(--tf-border)] rounded-md focus:ring-2 focus:ring-[var(--tf-color-primary)]"
          />
        </div>
      </div>

      <div x-show="formData.budget_type === 'hourly_retainer'" class="grid grid-cols-1 gap-4">
        <div>
          <label class="block text-sm font-medium text-[var(--tf-text-primary)] mb-1">Cantidad de horas</label>
          <input
            type="number"
            x-model="formData.budget_base_amount"
            placeholder="160"
            class="w-full px-4 py-2 border border-[var(--tf-border)] rounded-md focus:ring-2 focus:ring-[var(--tf-color-primary)]"
          />
          <p class="mt-1 text-xs text-[var(--tf-text-secondary)]">Total de horas contratadas para el proyecto</p>
        </div>
      </div>

      <div x-show="formData.budget_type === 'time_and_materials'" class="grid grid-cols-1 gap-4">
        <div class="p-4 bg-[var(--tf-bg-surface)] border border-[var(--tf-border)] rounded-md">
          <p class="text-sm text-[var(--tf-color-info)]">
            💡 En T&M se factura por el tiempo real trabajado. Puedes definir tarifas por rol en la configuración del proyecto.
          </p>
        </div>
      </div>
    </div>

    <!-- Step 4: Equipo (condicional) -->
    <div x-show="currentStep === teamStepNumber && organizationType === 'empresa'" class="space-y-6">
      <h3 class="text-2xl font-bold text-[var(--tf-text-primary)]">Equipo del Proyecto</h3>
      <p class="text-[var(--tf-text-secondary)]">Asigna miembros de tu organización</p>

      <div class="text-center py-12 text-[var(--tf-text-secondary)]">
        <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <p class="mt-4">Selector de equipo próximamente</p>      </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="flex justify-between mt-8 pt-6 border-t border-[var(--tf-border)]">
      <button
        type="button"
        @click="prevStep()"
        x-show="currentStep > 1"
        class="px-6 py-2 border border-[var(--tf-border)] rounded-md text-[var(--tf-text-primary)] hover:bg-[var(--tf-bg-surface)] font-medium transition-colors"
      >
        ← Anterior
      </button>
      <div x-show="currentStep === 1"></div>

      <button
        type="button"
        @click="nextStep()"
        x-show="currentStep < totalSteps"
        :disabled="!canProceed()"
        :class="canProceed() ? 'bg-[var(--tf-color-primary)] hover:bg-[var(--tf-color-primary-hover)]' : 'bg-[var(--tf-bg-surface)] cursor-not-allowed'"
        class="px-6 py-2 rounded-md text-white font-medium transition-colors"
      >
        Siguiente →
      </button>

      <button
        type="button"
        @click="submit()"
        x-show="currentStep === totalSteps"
        class="px-8 py-2 bg-[var(--tf-color-success)] hover:brightness-110 rounded-md text-white font-medium transition-colors"
      >
        ✓ Crear Proyecto
      </button>
    </div>
  </div>
</div>

<style>
  /* Estilos de modo oscuro para SuperWizard */
  [x-cloak] { display: none !important; }
  
  /* Contenedor principal */
  .max-w-4xl {
    color: var(--tf-text-primary);
  }
  
  /* Inputs */
  input[type="text"],
  input[type="number"],
  textarea,
  select {
    background-color: var(--tf-bg-input) !important;
    border-color: var(--tf-border) !important;
    color: var(--tf-text-primary) !important;
  }
  
