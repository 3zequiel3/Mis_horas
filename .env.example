# ============================================================================
# CONFIGURACIÓN EJEMPLO - MIS HORAS
# ============================================================================
# ⚠️  IMPORTANTE: Todas las variables son OBLIGATORIAS
# No hay valores por defecto - el contenedor no levantará sin todas ellas
# ============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo a .env en la raíz del proyecto
# 2. Completar TODOS los valores (no dejar ninguno vacío)
# 3. En producción, cambiar las contraseñas y claves por valores seguros
# ============================================================================

# GENERAL
# NODE_ENV: production|development (desarrollo con live reload)
# FLASK_ENV: production|development (desarrollo con debug)
NODE_ENV=development
FLASK_ENV=development
FLASK_DEBUG=True

# BASE DE DATOS MYSQL
# Solo accesible desde la red interna de Docker
DB_HOST=db
DB_PORT=3306
DB_USER=mis_horas
DB_PASSWORD=mis_horas
DB_NAME=mis_horas
DB_ROOT_PASSWORD=root

# PUERTOS PÚBLICOS - Rango 21000-33000
# Frontend: 21000
# Backend: 22000
FRONTEND_PUBLIC_PORT=21000
BACKEND_PUBLIC_PORT=22000

# BACKEND FLASK
# API_PORT es el puerto interno del contenedor (siempre 5000)
API_HOST=0.0.0.0
API_PORT=5000

# SEGURIDAD
# Generar una nueva clave:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=tu-clave-secreta-super-segura-cambiar-esto-en-produccion
JWT_EXPIRATION_HOURS=720

# CORS - Orígenes permitidos
# - Desarrollo local: http://localhost:21000
# - Producción: https://tu-servidor.com (sin puerto, HTTPS)
# Separar múltiples orígenes con comas
CORS_ORIGINS=http://localhost:21000

# FRONTEND ASTRO
# VITE_API_URL: URL que usa el navegador del cliente para conectar al backend
# - Desarrollo local: http://localhost:22000
# - Producción: http://tu-servidor.com:22000 o https://api.tu-servidor.com
# Importante: NO usar http://backend:5000 porque 'backend' no se resuelve en el navegador del cliente
VITE_API_URL=http://localhost:22000

# ============================================================================
# NOTAS IMPORTANTES:
# ============================================================================
# 🔒 SEGURIDAD DE RED:
# - La BD NO tiene puerto público, solo acceso interno desde la red mishoras-network
# - El backend y frontend se comunican internamente usando nombres de servicio
# - Los clientes externos acceden solo a través de los puertos públicos del rango 21000-33000
#
# 📡 PUERTOS:
# - Frontend: http://localhost:21000 (o tu IP/dominio:21000)
# - Backend (API): http://localhost:22000 (o tu IP/dominio:22000)
# - BD MySQL: No accesible desde internet (solo red interna)
#
# 🔗 COMUNICACIÓN:
# - DB_HOST=db (nombre del servicio Docker, no URL)
# - Los contenedores están en la red mishoras-network y se resuelven por nombre
#
# 🔐 PRODUCCIÓN:
# - Cambiar SECRET_KEY por un valor seguro
# - Cambiar contraseñas de BD
# - Actualizar CORS_ORIGINS con tus dominios reales
# - Configurar SSL/HTTPS con nginx o similar
#
# ⚠️  VERIFICACIÓN:
# - Todas estas variables DEBEN estar definidas
# - Si falta alguna, el contenedor no levantará
# - Revisar logs: docker compose logs backend
#
# 🔄 DESARROLLO CON LIVE RELOAD:
# Para tener live reload (cambios automáticos en el contenedor):
# 1. Cambiar .env a development:
#    NODE_ENV=development
#    FLASK_ENV=development
#    FLASK_DEBUG=True
# 2. Ejecutar: docker compose up -d
# 3. Los contenedores montarán volúmenes del código local
# 4. Cualquier cambio se reflejará automáticamente
#
# 🏭 PRODUCCIÓN:
# Cambiar .env a production:
#    NODE_ENV=production
#    FLASK_ENV=production
#    FLASK_DEBUG=False
# ============================================================================
